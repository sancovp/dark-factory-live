    "observe": {
      "findings": 7,
      "issues": [
        {
          "atom": "baking_temperature",
          "why": "450-500F omits that most dutch-oven recipes start at 475-500F then drop to 450 after lid removal, and flatbreads/pizzas run 500F+; the range is too narrow to guide a beginner",
          "price": 4,
          "url": "https://github.com/sancovp/dark-factory-live/issues/22"
        },
        {
          "atom": "baking_duration",
          "why": "20-50min range is too wide to be actionable; it never tells the user to check internal temp (200-210F) as the real doneness signal",
          "price": 1,
          "url": "https://github.com/sancovp/dark-factory-live/issues/23"
        },
        {
          "atom": "dutch_oven",
          "why": "Fails to state the load-bearing step: Dutch oven must be preheated covered for 30-45min BEFORE the dough goes in; a cold Dutch oven yields a flat, steamed-through loaf, not the claimed professional results",
          "price": 1,
          "url": "https://github.com/sancovp/dark-factory-live/issues/24"
        },
        {
          "atom": "acetic_acid",
          "why": "Implies oxygen presence is a requirement, but acetic acid forms throughout fermentation; oxygen promotes it relative to lactic acid, yet sourdough sealed in a banneton still produces acetic acid",
          "price": 49,
          "url": "https://github.com/sancovp/dark-factory-live/issues/25"
        },
        {
          "atom": "dough_temperature",
          "why": "Claim of 'predictable timing regardless of room conditions' is false; room temp still determines how fast warm dough cools or cold dough warms, affecting the fermentation rate after mixing",
          "price": 12,
          "url": "https://github.com/sancovp/dark-factory-live/issues/26"
        },
        {
          "atom": "fermentation_byproducts",
          "why": "Listing alcohols for aroma is misleading since ethanol and fusel alcohols evaporate entirely in the 200F+ oven, contributing zero aroma to finished bread",
          "price": 19,
          "url": "https://github.com/sancovp/dark-factory-live/issues/27"
        },
        {
          "atom": "crust",
          "why": "Attributes crust texture only to hydration and baking method, omitting steam as the primary driver; without steam in the first 20min, crust will be pale and cracked regardless of hydration",
          "price": 2,
          "url": "https://github.com/sancovp/dark-factory-live/issues/28"
        }
      ]
    },
