@prefix kb: <https://sancovp.github.io/kb-atlas/ns/concurrency_synchronization_primitives_and_memor#> .
@prefix kbo: <https://sancovp.github.io/kb-atlas/ns/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://sancovp.github.io/kb-atlas/ns/concurrency_synchronization_primitives_and_memor> a owl:Ontology ;
    rdfs:label "concurrency synchronization primitives and memory models" ;
    rdfs:comment "Machine-grown, Prolog-gate-admitted knowledge module. The gate proves coherence, not truth." .

# the tiny core vocabulary (self-contained on purpose)
kbo:Concept a owl:Class .
kbo:Certificate a owl:Class .
kbo:relatesTo a owl:ObjectProperty .
kbo:binds a owl:ObjectProperty .
kbo:because a owl:ObjectProperty .
kbo:since a owl:ObjectProperty .
kbo:togetherFit a owl:ObjectProperty .
kbo:explains a owl:ObjectProperty .

kb:aba_problem a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "aba problem" ;
    rdfs:comment "Race condition in CAS-based algorithms where value changes from A to B and back to A between check and update, fooling CAS into succeeding incorrectly; solved with tagged pointers or hazard tracking." .
kb:acquire_fence a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "acquire fence" ;
    rdfs:comment "A memory ordering primitive that ensures all load and store operations appearing after the fence in program order do not begin until the fence completes and all prior writes are visible." .
kb:acquire_op a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "acquire op" ;
    rdfs:comment "memory operation that observes writes made before a synchronizing release; includes load with acquire, mutex_lock, thread_join, sem_wait, barrier_wait" .
kb:acquire_semantics a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "acquire semantics" ;
    rdfs:comment "Memory ordering semantics ensuring all subsequent loads/stores cannot be reordered before the acquire operation; used for lock acquisition, reading a flag after volatile write." .
kb:acquisition_collision a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "acquisition collision" ;
    rdfs:comment "Multiple threads competing simultaneously for the same contested lock after waking; the collision created by the wake spike." .
kb:address_dependency a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "address dependency" ;
    rdfs:comment "A data dependency where the value loaded from address A is used to compute the address of a subsequent load, establishing an intra-thread ordering that carries visibility across weakly ordered architectures." .
kb:amdahl_law a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "amdahl law" ;
    rdfs:comment "Formula limiting parallel speedup by the serial fraction of computation; speedup <= 1 / (serial_fraction + parallel_fraction / num_threads); motivates minimization of synchronized serial sections." .
kb:arm_dmb a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "arm dmb" ;
    rdfs:comment "The ARM Data Memory Barrier instruction; options for full (dmb sy), store (dmb st), or load (dmb ld) barriers providing the corresponding memory ordering on ARM/ARM64 architectures." .
kb:arm_isb a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "arm isb" ;
    rdfs:comment "The ARM Instruction Synchronization Barrier; flushes the pipeline ensuring all following instructions fetch from memory, used to make speculative updates visible." .
kb:arm_memory_model a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "arm memory model" ;
    rdfs:comment "Weak memory model used by ARM processors where memory operations may be reordered extensively unless explicitly ordered by barriers; most permissive of common architectures." .
kb:atomic_alignment_prerequisite a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "atomic alignment prerequisite" ;
    rdfs:comment "For the atomicity guarantee to hold the target variable must meet the hardware's alignment requirements, typically aligned to its natural size or to std::atomic's enforced alignment; misaligned access on some architectures may lack the indivisibility guarantee." .
kb:atomic_alignment_prerequisite_enables_indivisibility_guarantee a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "atomic alignment prerequisite enables indivisibility guarantee" ;
    rdfs:comment "Proper alignment is a necessary precondition for the hardware to provide the indivisibility guarantee; without correct alignment the guarantee may not hold on architectures with strict alignment requirements." .
kb:atomic_cas a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "atomic cas" ;
    rdfs:comment "Compare-and-swap operation atomically loading a value, comparing it to an expected value, and storing a new value only if they matched, returning whether the swap occurred." .
kb:atomic_compare_exchange a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "atomic compare exchange" ;
    rdfs:comment "C++11/C11 atomic operation attempting to replace expected value with desired; returns boolean indicating success; on failure, expected is updated with actual value for retry loops." .
kb:atomic_exchange a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "atomic exchange" ;
    rdfs:comment "Atomic operation that reads the current value of a variable and writes a new value in a single indivisible step, returning the old value." .
kb:atomic_fence a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "atomic fence" ;
    rdfs:comment "fence operation establishing memory barriers independent of specific atomic locations; can create synchronizes_with between release and acquire" .
kb:atomic_fetch_add a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "atomic fetch add" ;
    rdfs:comment "An atomic read-modify-write that atomically increments a value and returns the prior value; the read component acquires, the write component releases, creating synchronize-with edges for surrounding operations." .
kb:atomic_load a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "atomic load" ;
    rdfs:comment "load operation with memory_order semantics; load with acquire is the endpoint of synchronizes_with from release store" .
kb:atomic_location a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "atomic location" ;
    rdfs:comment "memory location accessed with atomic operations; synchronizes_with operates on atomic variables or fences between them" .
kb:atomic_operation a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "atomic operation" ;
    rdfs:comment "Operation appearing indivisible to other threads; either hardware-supported single instruction atomics or software-implemented atomic primitives using CAS loops." .
kb:atomic_rmw a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "atomic rmw" ;
    rdfs:comment "read-modify-write atomic operation; fetch_add, compare_exchange with acquire/release; participates in synchronizes_with chains" .
kb:atomic_store a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "atomic store" ;
    rdfs:comment "store operation with memory_order semantics; store with release triggers synchronizes_with on matching acquire" .
kb:atomic_variable_scope a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "atomic variable scope" ;
    rdfs:comment "The scope boundary of atomicity guarantees limited to the specific atomic variable being read or written; other variables in the program are unaffected by this atomicity property." .
kb:backoff_iteration a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "backoff iteration" ;
    rdfs:comment "Zero-based counter tracking how many consecutive failed lock acquisition attempts have occurred since last success." .
kb:backoff_multiplier a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "backoff multiplier" ;
    rdfs:comment "Scaling factor (commonly 2.0) that multiplies the current delay on each failed acquisition attempt to produce the next delay interval." .
kb:barrier_arrival a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "barrier arrival" ;
    rdfs:comment "The event when a thread reaches a synchronization barrier; each arrival synchronizes-with all other arrival events at the same barrier instance, enforcing a global rendezvous." .
kb:barrier_release a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "barrier release" ;
    rdfs:comment "The event when the last thread departs a barrier; creates a synchronizes-with edge for all threads, equivalent to all prior arrivals." .
kb:barrier_synchronization a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "barrier synchronization" ;
    rdfs:comment "Primitive blocking threads until all threads in a set reach the barrier point; threads proceed only after the group is complete; used in fork-join and bulk-synchronous parallelism." .
kb:barrier_wait a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "barrier wait" ;
    rdfs:comment "synchronization point where all threads must arrive; when last thread passes barrier, all threads synchronize via the barrier" .
kb:base_delay a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "base delay" ;
    rdfs:comment "Initial wait time in nanoseconds or microseconds before the first lock acquisition retry; the starting point of the exponential schedule." .
kb:binary_semaphore a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "binary semaphore" ;
    rdfs:comment "Semaphore with counter restricted to 0 or 1; functions like a mutex but without ownership semantics; can be signaled by non-owner thread." .
kb:bounded_buffer a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "bounded buffer" ;
    rdfs:comment "Classic synchronization problem with fixed-size buffer between producers and consumers; requires empty/full conditions and mutual exclusion; solution uses semaphores or monitors." .
kb:bounded_waiting a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "bounded waiting" ;
    rdfs:comment "Property requiring that after a thread requests entry to a critical section, there is a bound on the number of other threads allowed to enter before the requester." .
kb:broadcast_signal a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "broadcast signal" ;
    rdfs:comment "The invocation or mechanism that triggers wake_all_semantics; e.g., pthread_cond_broadcast, event_group.set_all, NotifyAll in a monitor." .
kb:c11_atomic a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "c11 atomic" ;
    rdfs:comment "The C11/C++11 memory model defined by the ISO standard; defines six memory orders (relaxed, consume, acquire, release, acq_rel, seq_cst) and formalizes synchronizes-with and happens-before." .
kb:c11_atomic_thread_fence_contrast a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "c11 atomic thread fence contrast" ;
    rdfs:comment "A relaxed atomic operation is not a thread fence; unlike atomic_thread_fence with memory_order_seq_cst, a relaxed operation imposes no memory barrier that would establish synchronization between threads." .
kb:c11_memory_model a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "c11 memory model" ;
    rdfs:comment "Standard C11 specification defining memory orderings: memory_order_relaxed, memory_order_consume, memory_order_acquire, memory_order_release, memory_order_acq_rel, memory_order_seq_cst; defines happens-before and synchronizes-with relations." .
kb:cache_alignment a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "cache alignment" ;
    rdfs:comment "Placement of data structures on memory boundaries matching cache line size, typically 64 bytes, preventing false sharing between adjacent data." .
kb:cache_coherence a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "cache coherence" ;
    rdfs:comment "The hardware guarantee that reads observe the most recent write to the same address in the coherent cache hierarchy; defines the per-address visibility baseline." .
kb:cache_coherency a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "cache coherency" ;
    rdfs:comment "Protocol ensuring that multiple caches sharing a memory location present a consistent view; MESI, MOESI, MESIF protocols maintain coherence across CPU cores." .
kb:cache_line_ping_pong a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "cache line ping pong" ;
    rdfs:comment "Performance anti-pattern where threads on different cores repeatedly invalidate each other's cache line, causing excessive coherency traffic; often caused by false sharing or poorly designed data structures." .
kb:carries_dependency a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "carries dependency" ;
    rdfs:comment "property of an operation depending on the result of another; forms happens_before under consume semantics when synchronizes_with absent" .
kb:cas_loop a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "cas loop" ;
    rdfs:comment "compare-and-swap retry loop; each iteration is a load-acquire and store-release attempt; progress requires lock freedom" .
kb:causal_consistency_boundary a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "causal consistency boundary" ;
    rdfs:comment "Relaxed operations respect intra-thread causality (program order) but do not guarantee inter-thread causality; this boundary defines the scope of what relaxed_atomicity guarantees." .
kb:channel_csp a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "channel csp" ;
    rdfs:comment "Communication primitive from Communicating Sequential Processes model; send and receive operations synchronize producers and consumers; implementations include Go channels, Clojure core.async." .
kb:clh_lock a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "clh lock" ;
    rdfs:comment "Queued lock using a linked list of nodes with spinning on predecessor's flag; provides scalability and fairness similar to MCS but different cache behavior." .
kb:coherence a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "coherence" ;
    rdfs:comment "Property that each memory location has a single globally visible value at any instant; distinct from consistency, coherence governs single-location semantics while consistency governs multi-location ordering." .
kb:compare_and_swap_cas a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "compare and swap cas" ;
    rdfs:comment "Atomic instruction comparing a value with expected and swaps only if equal; fundamental building block for lock-free algorithms; ABA problem may require additional solutions." .
kb:compiler_barrier a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "compiler barrier" ;
    rdfs:comment "Directive preventing the compiler from reordering memory operations across the barrier; does not emit hardware instructions but prevents compiler optimization from causing races." .
kb:completable_future a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "completable future" ;
    rdfs:comment "Java class implementing Future with completion callbacks, chaining, and composition; supports thenApply, thenCompose, exceptionally; enables non-blocking asynchronous pipelines." .
kb:condition_variable a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "condition variable" ;
    rdfs:comment "Primitive enabling a thread to wait for a condition to become true; must be used with a mutex; wait atomically releases the mutex and blocks; notify/notify_all wake waiting threads." .
kb:condition_variable_trigger a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "condition variable trigger" ;
    rdfs:comment "The specific use of a condition variable with broadcast to notify waiting threads; a primary vector for thundering herd emergence in monitor-based code." .
kb:condvar_broadcast a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "condvar broadcast" ;
    rdfs:comment "A condition variable broadcast that wakes all waiting threads; each woken thread's lock acquire synchronizes-with the broadcast operation." .
kb:condvar_signal a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "condvar signal" ;
    rdfs:comment "signal operation on condition variable; may synchronize_with a condvar_wait on the same condition variable and mutex" .
kb:condvar_wait a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "condvar wait" ;
    rdfs:comment "wait operation on condition variable; releases associated mutex (release) and blocks until signal (acquire); part of condvar synchronizes_with" .
kb:consume_semantics a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "consume semantics" ;
    rdfs:comment "memory ordering where subsequent operations dependent on the consumed load respect dependency order rather than synchronizes_with" .
kb:context_switch a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "context switch" ;
    rdfs:comment "Operating system operation saving one thread's state and restoring another's; involves kernel transition, register saves, TLB invalidation; cost motivates lock-free and per-thread data designs." .
kb:control_dependency a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "control dependency" ;
    rdfs:comment "A control-flow-based ordering: when a load controls whether a later operation executes, that ordering contributes to the intra-thread happens-before chain without a fence." .
kb:countdown_latch a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "countdown latch" ;
    rdfs:comment "One-time barrier initialized with a count; threads decrement count on completion; barrier opens when count reaches zero; cannot be reused." .
kb:counting_semaphore a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "counting semaphore" ;
    rdfs:comment "General semaphore with non-negative integer counter allowing multiple concurrent accesses; used for resource pooling and bounded work distribution." .
kb:cpp11_memory_model a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "cpp11 memory model" ;
    rdfs:comment "C++11 and later standard library memory model supporting atomic operations with configurable ordering; provides std::atomic with memory_order enum values matching C11 semantics." .
kb:cross_thread_visibility_non_global a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "cross thread visibility non global" ;
    rdfs:comment "Other threads may observe relaxed operations in any order relative to each other; there is no single total order visible to all threads as there is with sequentially_consistent." .
kb:current_delay a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "current delay" ;
    rdfs:comment "The computed wait interval for the current retry iteration; derived from base_delay multiplied by backoff_multiplier raised to the iteration count, then capped by delay_ceiling." .
kb:cyclic_barrier a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "cyclic barrier" ;
    rdfs:comment "Barrier implementation that resets after all threads pass; supports configurable thread count and optional action executed when barrier breaks." .
kb:data_race a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "data race" ;
    rdfs:comment "Specific concurrent access where at least one access is a write, accesses are to same memory location, and accesses are not properly synchronized; undefined behavior in C11/C++11." .
kb:deadlock a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "deadlock" ;
    rdfs:comment "Liveness failure where two or more threads wait indefinitely for conditions held by each other; occurs with circular wait, hold-and-wait, no preemption, and mutual exclusion." .
kb:deadlock_prevention a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "deadlock prevention" ;
    rdfs:comment "Design strategies eliminating one of the four Coffman conditions: no circular wait (lock ordering), hold-and-wait (acquire all at once), preemption (non-preemptive resources), mutual exclusion (lock-free alternatives)." .
kb:decorrelated_jitter a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "decorrelated jitter" ;
    rdfs:comment "Jitter strategy where each thread computes delay = random.uniform(min_delay, previous_delay * 3); history-dependent decorrelation reduces coordinated retry waves." .
kb:dekker_algorithm a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dekker algorithm" ;
    rdfs:comment "First correct two-process mutual exclusion algorithm achieving progress under sequential consistency; combines turn-taking with turn variable; also fails under relaxed memory ordering." .
kb:delay_ceiling a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "delay ceiling" ;
    rdfs:comment "Upper bound cap on the computed delay; prevents unbounded growth of wait times when contention persists across many iterations." .
kb:dependency_chain a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dependency chain" ;
    rdfs:comment "data or control dependency from one operation to another; under consume semantics substitutes for synchronizes_with" .
kb:dining_philosophers a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dining philosophers" ;
    rdfs:comment "Classic deadlock problem with N philosophers at circular table needing both adjacent forks; demonstrates resource ordering, deadlock avoidance, and starvation-free synchronization design." .
kb:djt_bounding_range a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "djt bounding range" ;
    rdfs:comment "The closed interval [min_delay, previous_delay times decorrelation_factor] from which the uniform random sample is drawn to compute the next current_delay; bounds the worst-case wait while allowing history-dependent growth." .
kb:djt_decorrelation_factor a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "djt decorrelation factor" ;
    rdfs:comment "The multiplicative constant (commonly 3.0) that scales previous_delay to produce the upper bound of the sampling range; governs how aggressively the wait distribution spreads across retry iterations." .
kb:djt_history_state a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "djt history state" ;
    rdfs:comment "The accumulated sequence of previous_delay values maintained per thread that enables history-dependent decorrelation; each thread derives its next upper bound from its own history rather than a shared schedule." .
kb:djt_min_delay a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "djt min delay" ;
    rdfs:comment "Lower bound of the uniform sampling range in decorrelated jitter; typically derived from base_delay and serves as the floor below which no wait interval may fall, ensuring at least a minimal pause before retry." .
kb:djt_previous_delay a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "djt previous delay" ;
    rdfs:comment "The computed wait interval from the immediately prior backoff iteration on the same thread; serves as the history anchor from which the upper bound of the new sampling range is derived." .
kb:djt_random_uniform_sample a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "djt random uniform sample" ;
    rdfs:comment "The uniform random draw within the bounding range that produces the new current_delay value; the randomness decorrelates this thread's retry timing from concurrent threads." .
kb:djt_thread_local_state a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "djt thread local state" ;
    rdfs:comment "Per-thread isolation of history_state and current_delay computation; ensures no shared counter or schedule exists across competing threads, preventing coordinated retry waves." .
kb:djt_wave_attenuation a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "djt wave attenuation" ;
    rdfs:comment "The emergent property that decorrelated jitter reduces the probability of simultaneous retries among competing threads; achieved through per-thread history-dependent ranges that diverge over time." .
kb:epoch_based_reclamation a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "epoch based reclamation" ;
    rdfs:comment "Memory reclamation scheme batching deletions into epochs; threads must wait for active epochs to complete before reclaiming protected memory; balances throughput and safety." .
kb:equal_jitter a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "equal jitter" ;
    rdfs:comment "Jitter strategy computing delay = base_delay / 2 + random.uniform(0, base_delay / 2); ensures wait never falls below half the nominal delay." .
kb:event_notification_trigger a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "event notification trigger" ;
    rdfs:comment "The use of an event or manual-reset signaling object that wakes all waiters; a primary vector distinct from condition-variable-based triggers." .
kb:exponential_backoff a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "exponential backoff" ;
    rdfs:comment "Contention management strategy backing off exponentially after failed lock acquisition; reduces bus traffic and collision; common in spinlock and CAS-based algorithm implementations." .
kb:exponential_backoff_window a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "exponential backoff window" ;
    rdfs:comment "Exponential backoff applied post-wake to decorrelate retry timing of competing threads; reduces acquisition_collision frequency." .
kb:failed_awakening a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "failed awakening" ;
    rdfs:comment "A thread woken from a blocking wait that immediately discovers it cannot acquire the resource and must re-block or retry; the atomic waste unit of a thundering herd." .
kb:false_sharing a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "false sharing" ;
    rdfs:comment "Performance problem where unrelated variables sharing a cache line cause cache coherency traffic when one is modified; threads updating different variables contend due to line-level sharing." .
kb:fence_ineffectiveness_on_relaxed a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "fence ineffectiveness on relaxed" ;
    rdfs:comment "Placing a release fence after a relaxed store does not retroactively give the store release semantics; fences only constrain operations that follow them, not operations that precede them in program order." .
kb:fence_synchronizes_with_fence a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "fence synchronizes with fence" ;
    rdfs:comment "A pair of fences on different threads where the second fence in program order synchronizes-with the first fence establishing an ordering boundary." .
kb:fence_synchronizes_with_op a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "fence synchronizes with op" ;
    rdfs:comment "A relation where a fence on one thread establishes a synchronizes-with edge over an operation on another thread that accesses memory visible across the fence boundary." .
kb:fetch_and_add a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "fetch and add" ;
    rdfs:comment "Atomic operation returning old value while atomically incrementing memory location; used for counters, ticket distribution, and implementing certain lock-free structures." .
kb:fork_join_parallelism a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "fork join parallelism" ;
    rdfs:comment "Parallelism pattern where work recursively splits into subtasks that join at barriers; implementations like Java ForkJoinFramework provide efficient work stealing for divide-conquer algorithms." .
kb:full_fence a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "full fence" ;
    rdfs:comment "A memory fence providing both acquire and release semantics; no memory operation on the issuing core may be reordered across the fence in either direction." .
kb:full_jitter a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "full jitter" ;
    rdfs:comment "Jitter strategy selecting a uniform random value in the range [0, current_delay]; maximizes desynchronization at the cost of potentially very short waits." .
kb:futex a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "futex" ;
    rdfs:comment "Fast userspace mutex kernel-assisted synchronization; userspace spinning first, then syscall to kernel for wait/wake; basis for most Linux threading primitives." .
kb:futex_wait a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "futex wait" ;
    rdfs:comment "block on futex address with expected value; acquire semantics waiting for wake from another thread" .
kb:futex_wake a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "futex wake" ;
    rdfs:comment "wake operation on futex; release semantics that synchronizes_with futex_wait that was blocking on the address" .
kb:future_promise a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "future promise" ;
    rdfs:comment "Concurrency pattern decoupling value computation from access; Future represents pending result, Promise provides completion mechanism; enables asynchronous composition." .
kb:happens_before a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "happens before" ;
    rdfs:comment "transitive closure of program_order and synchronizes_with relations; the ordering guarantee that prevents data races" .
kb:happens_before_order a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "happens before order" ;
    rdfs:comment "A transitive, irreflexive partial order over operations in a memory model that defines which operations must appear to precede others from any thread's perspective." .
kb:happens_before_relation a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "happens before relation" ;
    rdfs:comment "A fundamental ordering relation in memory models defining that if operation A happens-before operation B, then A's effects are visible to B; forms the basis for reasoning about program correctness in concurrent settings." .
kb:hardware_transactional_memory_htm a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "hardware transactional memory htm" ;
    rdfs:comment "CPU-supported transactional execution using cache hierarchies to track conflicts; Intel TSX and IBM Blue Gene/Q implementations; aborts on cache conflict or unsupported instruction." .
kb:hazard_pointers a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "hazard pointers" ;
    rdfs:comment "Memory reclamation technique where each thread publishes dangerous pointers to globally accessible locations; memory cannot be reclaimed while referenced by any hazard pointer." .
kb:hb_acquire_fence a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "hb acquire fence" ;
    rdfs:comment "A memory fence that provides acquire semantics, ensuring all loads and stores after the fence are not reordered before the fence itself is observed." .
kb:hb_acquire_semantics a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "hb acquire semantics" ;
    rdfs:comment "A memory ordering guarantee where all subsequent memory operations become visible only after the acquire operation; paired with release to establish synchronization." .
kb:hb_antisymmetry a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "hb antisymmetry" ;
    rdfs:comment "The property that if A happens-before B and B happens-before A, then A and B are the same operation; ensures well-defined ordering." .
kb:hb_carries_dependency a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "hb carries dependency" ;
    rdfs:comment "A memory order where a load carries a dependency into subsequent loads or stores, extending the happens-before chain through data dependency." .
kb:hb_causality_order a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "hb causality order" ;
    rdfs:comment "The partial order constraint that ensures cause precedes effect across the program, preventing out-of-thin-air values." .
kb:hb_coherence_order a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "hb coherence order" ;
    rdfs:comment "The total order of all writes to the same memory location that determines which write a subsequent read will observe." .
kb:hb_dependency_chain a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "hb dependency chain" ;
    rdfs:comment "An explicit or implicit dependency from one operation to another that strengthens happens-before ordering beyond simple synchronization." .
kb:hb_interrupt_visibility a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "hb interrupt visibility" ;
    rdfs:comment "The guaranteed visibility of operations completed before an interrupt or context switch to the handler executing after." .
kb:hb_irreflexivity a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "hb irreflexivity" ;
    rdfs:comment "The property that no operation can happen-before itself; prevents circular causality in the ordering relation." .
kb:hb_lock_acquire a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "hb lock acquire" ;
    rdfs:comment "Acquiring a synchronization lock, which carries acquire semantics for all operations following the acquisition." .
kb:hb_lock_release a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "hb lock release" ;
    rdfs:comment "Releasing a synchronization lock, which carries release semantics for all operations preceding the release." .
kb:hb_modification_order a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "hb modification order" ;
    rdfs:comment "For a single variable, the total order of all writes to that variable; writes to the same variable are totally ordered within a thread's view." .
kb:hb_program_order a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "hb program order" ;
    rdfs:comment "The order of operations as they appear in source code within a single thread; a fundamental component of happens-before that preserves intra-thread ordering." .
kb:hb_reads_from a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "hb reads from" ;
    rdfs:comment "The relation connecting a read operation to the write operation whose value it observes; foundational to establishing inter-thread ordering." .
kb:hb_release_fence a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "hb release fence" ;
    rdfs:comment "A memory fence that provides release semantics, ensuring all loads and stores before the fence are visible before the fence itself is issued." .
kb:hb_release_semantics a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "hb release semantics" ;
    rdfs:comment "A memory ordering guarantee where all prior memory operations become visible before the release operation; paired with acquire to establish synchronization." .
kb:hb_seq_cst_boundary a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "hb seq cst boundary" ;
    rdfs:comment "The demarcation point where sequentially consistent operations establish a total order that all threads observe identically." .
kb:hb_synchronization_order a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "hb synchronization order" ;
    rdfs:comment "A total order established by synchronization operations (locks, barriers, atomic ops) that defines the global ordering of synchronization actions across all threads." .
kb:hb_synchronizes_with a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "hb synchronizes with" ;
    rdfs:comment "A synchronization operation or primitive that establishes an inter-thread happens-before relationship, ensuring that all memory effects preceding the synchronization point in one thread become visible to all operations following the corresponding synchronization point in another thread; the fundamental mechanism by which threads coordinate access to shared state, encompassing operations such as th" .
kb:hb_thread_join a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "hb thread join" ;
    rdfs:comment "The join operation on a thread; the last operation in that thread happens-before the join operation completes in the joining thread." .
kb:hb_thread_start a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "hb thread start" ;
    rdfs:comment "The launch point of a thread; the start operation happens-before the first operation executed in that thread." .
kb:hb_transitive_closure a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "hb transitive closure" ;
    rdfs:comment "The transitive property of happens-before: if A happens-before B and B happens-before C, then A happens-before C." .
kb:hb_transitivity a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "hb transitivity" ;
    rdfs:comment "The property that if A happens-before B and B happens-before C, then A happens-before C; defines happens_before as a transitive relation." .
kb:indivisibility_guarantee a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "indivisibility guarantee" ;
    rdfs:comment "The foundational property that a relaxed atomic operation completes as one indivisible step; no observer can witness any partial execution of the operation." .
kb:indivisibility_guarantee_scope_limited_to_target_variable a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "indivisibility guarantee scope limited to target variable" ;
    rdfs:comment "The indivisibility guarantee does not extend beyond the specific atomic variable being read or written; no additional memory locations are protected or made visible atomically by the operation." .
kb:indivisibility_property a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "indivisibility property" ;
    rdfs:comment "The fundamental property that a relaxed atomic operation executes as a single indivisible step from the perspective of all threads; the operation either completes fully or not at all without observable intermediate states." .
kb:instruction_reordering a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "instruction reordering" ;
    rdfs:comment "CPU or compiler reordering of memory operations for performance while preserving single-thread correctness; can violate programmer expectations in concurrent code without proper barriers." .
kb:inter_thread_happens_before a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "inter thread happens before" ;
    rdfs:comment "The subset of happens_before relations that cross thread boundaries, established by synchronizes_with connections between release and acquire operations." .
kb:intermediate_state_invisibility a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "intermediate state invisibility" ;
    rdfs:comment "The guarantee that no thread can observe a partially completed relaxed atomic operation; all threads observe either the state before or after the operation, never during its execution." .
kb:intra_thread_program_order a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "intra thread program order" ;
    rdfs:comment "Within a single thread, the thread still observes its own relaxed operations in program order; this total order is local to the thread and not shared." .
kb:invalidate_queue a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "invalidate queue" ;
    rdfs:comment "Hardware queue holding pending invalidation requests for cache lines; entries must be drained before a core can ensure it has exclusive ownership of a cache line." .
kb:isi_atomicity_boundary a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "isi atomicity boundary" ;
    rdfs:comment "The demarcation line separating the before-state from the after-state of a relaxed atomic operation; no observable execution window exists across this boundary." .
kb:isi_load_visibility_rule a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "isi load visibility rule" ;
    rdfs:comment "For a relaxed atomic load, the read returns exactly one value from the modification order; no torn read of a partial encoding is observable." .
kb:isi_no_in_flight_state a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "isi no in flight state" ;
    rdfs:comment "The guaranteed absence of any transient value during operation execution that could be sampled by a concurrent thread; the in-flight state is logically invisible." .
kb:isi_observer_exclusivity a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "isi observer exclusivity" ;
    rdfs:comment "The constraint that any given observer of a relaxed atomic operation sees exclusively one of the two complete states; mixed or hybrid observations are prohibited." .
kb:isi_operation_completeness a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "isi operation completeness" ;
    rdfs:comment "The property that a relaxed atomic operation executes to full completion before any observer can witness its effect or lack thereof; partial execution is undetectable." .
kb:isi_post_state_visibility a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "isi post state visibility" ;
    rdfs:comment "The state of the target atomic variable after the operation has fully completed, which is the only alternative state an observer may witness." .
kb:isi_pre_state_visibility a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "isi pre state visibility" ;
    rdfs:comment "The state of the target atomic variable as it existed before the operation commenced, which is the only alternative state an observer may witness." .
kb:isi_rmw_visibility_rule a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "isi rmw visibility rule" ;
    rdfs:comment "For a relaxed read-modify-write operation, observers see either the complete state before the modification or the complete state after modification; the read-modify-write executes atomically without observable intermediate stages." .
kb:isi_store_visibility_rule a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "isi store visibility rule" ;
    rdfs:comment "For a relaxed atomic store, any reading thread observes either the complete value that existed before the store or the complete value after the store; torn writes are impossible." .
kb:java_memory_model a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "java memory model" ;
    rdfs:comment "Java Memory Model (JSR-133) specifying happens-before guarantees for synchronized blocks, volatile fields, thread start/join; defines ordering guarantees for concurrent Java programs." .
kb:jitter a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "jitter" ;
    rdfs:comment "Randomized variance introduced into the computed delay to decorrelate competing threads and mitigate thundering-herd synchronization on lock release." .
kb:lamport_bakery_algorithm a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "lamport bakery algorithm" ;
    rdfs:comment "N-thread mutual exclusion algorithm providing first-come-first-served ordering; uses ticket numbers; correct under sequential consistency but requires adaptation for weak memory models." .
kb:linearizability a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "linearizability" ;
    rdfs:comment "Correctness criterion requiring each operation appear to execute atomically at some point between invocation and response; composable property essential for concurrent object specifications." .
kb:livelock a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "livelock" ;
    rdfs:comment "Failure where threads continuously respond to each other without making progress; distinguishable from deadlock by active state; often result of excessive collision avoidance." .
kb:load_buffering a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "load buffering" ;
    rdfs:comment "Phenomenon in weak memory models where a load may observe a store from a different thread that happens later in global order, enabling patterns impossible under SC." .
kb:load_buffering_allowed a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "load buffering allowed" ;
    rdfs:comment "Under relaxed ordering, a thread may read a value it will later write (load buffering) because relaxed operations do not prohibit such behavior unlike sequentially consistent or release-acquire patterns." .
kb:load_indivisibility a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "load indivisibility" ;
    rdfs:comment "A relaxed atomic load returns exactly one value from the modification order of the target variable; no torn read of a partial value encoded in fewer bits than the atomic word is possible." .
kb:load_linked a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "load linked" ;
    rdfs:comment "load-linked atomic operation; part of LLSC pair; acquire semantics for the linked address" .
kb:load_linked_store_conditional a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "load linked store conditional" ;
    rdfs:comment "Pair of instructions for software atomic operations: LL reads atomically, SC writes only if no intervening store occurred; used on ARM, PowerPC; avoids ABA problem inherent to CAS." .
kb:lock_acquire a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "lock acquire" ;
    rdfs:comment "A synchronization operation that atomically claims exclusive access to a protected region; on most architectures it is an acquire operation establishing a synchronizes-with edge with the matching release." .
kb:lock_elision a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "lock elision" ;
    rdfs:comment "Optimization technique using HTM or CAS to execute critical sections without holding the lock when no conflict occurs; combines performance of no-locking with safety of mutual exclusion." .
kb:lock_free a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "lock free" ;
    rdfs:comment "Progress guarantee where system-wide progress is always made; at least one thread completes an operation in finite steps regardless of other thread interference." .
kb:lock_release a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "lock release" ;
    rdfs:comment "A synchronization operation that atomically relinquishes exclusive access; it is a release operation establishing a synchronizes-with edge with all subsequent acquires of the same lock." .
kb:mcs_lock a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "mcs lock" ;
    rdfs:comment "Queued lock where each waiting thread spins on a locally-owned node linked into a queue; cache-friendly with only O(1) bus traffic per lock acquisition; named after Mellor-Crummey and Scott." .
kb:mcs_lock_acquire a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "mcs lock acquire" ;
    rdfs:comment "Operation by which a thread obtains the lock; spins polling its own qnode.locked field until false; returns only after predecessor has released and cleared the flag; no shared atomic variable is spun on." .
kb:mcs_lock_enqueue a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "mcs lock enqueue" ;
    rdfs:comment "Operation appending a thread-local qnode to the queue tail; atomically CASes qnode into tail; on CAS failure, completes the predecessor's link and retries; ensures FIFO acquisition order." .
kb:mcs_lock_fifo_ordering a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "mcs lock fifo ordering" ;
    rdfs:comment "Property guaranteed by MCS queue structure; lock acquisition order matches the order of enqueue operations; provides fairness without centralized ticket counters." .
kb:mcs_lock_help_links a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "mcs lock help links" ;
    rdfs:comment "Backoff resolution protocol during failed enqueue CAS; the thread that lost the CAS follows the discovered pointer chain to complete the linking work of the winner before retrying its own append; prevents starvation under high contention." .
kb:mcs_lock_local_spinning a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "mcs lock local spinning" ;
    rdfs:comment "Performance property of MCS; each waiter spins on its own thread-local qnode in its own cache line; eliminates cache-line ping-ponging between spinning threads; reduces bus traffic to O(1) per lock handoff." .
kb:mcs_lock_qnode a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "mcs lock qnode" ;
    rdfs:comment "Thread-local queue node containing locked flag and successor pointer; must be cache-aligned and allocated per-thread to enable local spinning without shared contention." .
kb:mcs_lock_qnode_locked a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "mcs lock qnode locked" ;
    rdfs:comment "Boolean field in qnode; spinning thread reads this; set true on enqueue and cleared false by predecessor upon release; default true indicates lock not yet released." .
kb:mcs_lock_qnode_next a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "mcs lock qnode next" ;
    rdfs:comment "Pointer field in qnode referencing successor qnode; null until predecessor links this node; spinning thread polls this to detect when it has been chained into the queue." .
kb:mcs_lock_release a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "mcs lock release" ;
    rdfs:comment "Operation by which a thread releases the lock; sets own qnode.locked to false to unblock spinning successor; if successor exists in qnode.next, responsibility transfers to successor's own spin; cache-friendly O(1) handoff." .
kb:mcs_lock_tail a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "mcs lock tail" ;
    rdfs:comment "Atomic shared pointer to the last enqueued qnode; initialized null; updated via CAS during enqueue; represents the lock acquisition frontier." .
kb:mcs_lock_wait_for_successor a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "mcs lock wait for successor" ;
    rdfs:comment "Sub-protocol when release finds no successor yet linked; thread performing release or a helper spins on qnode.next until non-null; ensures no lock holder exits before its successor is queued." .
kb:memory_barrier a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "memory barrier" ;
    rdfs:comment "Instruction or hardware mechanism that prevents reordering of memory operations across the barrier; ensures visibility and ordering of loads and stores relative to the barrier point." .
kb:memory_barrier_pair a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "memory barrier pair" ;
    rdfs:comment "A matched release fence on one thread and acquire fence on another thread that together establish an inter-thread happens-before relationship." .
kb:memory_fence a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "memory fence" ;
    rdfs:comment "Synonym for memory barrier; hardware instruction enforcing visibility and ordering constraints on memory operations across the fence; variations include full fence, store fence, load fence." .
kb:memory_order_acq_rel a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "memory order acq rel" ;
    rdfs:comment "A memory ordering that is simultaneously acquire and release; applies to read-modify-write atomics and makes the update visible atomically with surrounding writes." .
kb:memory_order_acquire a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "memory order acquire" ;
    rdfs:comment "Memory ordering barrier ensuring all loads and stores after the barrier in program order cannot be reordered before it, synchronizing with release stores." .
kb:memory_order_consume a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "memory order consume" ;
    rdfs:comment "C11/C++11 ordering enforcing data-dependency ordering; subsequent operations dependent on the consumed value maintain ordering but other operations may reorder; often optimized to acquire." .
kb:memory_order_relaxed a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "memory order relaxed" ;
    rdfs:comment "C11/C++11 memory ordering that only guarantees atomicity of the operation with no ordering constraints relative to other operations; allows all reorderings." .
kb:memory_order_relaxed_atomicity_guarantee a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "memory order relaxed atomicity guarantee" ;
    rdfs:comment "The indivisibility guarantee that a relaxed atomic operation completes as a single indivisible step; no intermediate state is observable by other threads during the operation, scoped to the specific atomic variable being read or written." .
kb:memory_order_relaxed_atomicity_guarantee_implies_load_store_atomicity a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "memory order relaxed atomicity guarantee implies load store atomicity" ;
    rdfs:comment "The indivisibility guarantee applies uniformly to both load and store operations on the relaxed atomic variable; the atomicity property is not conditional on the operation direction." .
kb:memory_order_relaxed_coherence_per_location a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "memory order relaxed coherence per location" ;
    rdfs:comment "The property that each atomic variable maintains its own independent coherence order but this order is not coordinated with coherence orders of other variables; operations on separate variables are totally unordered with respect to each other." .
kb:memory_order_relaxed_load_value_visibility a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "memory order relaxed load value visibility" ;
    rdfs:comment "The undefined timing of when a relaxed load obtains its value; a load may observe any value from the modification order up to that point, with no guarantee about when the load's value becomes visible to other threads." .
kb:memory_order_relaxed_mod_order_def a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "memory order relaxed mod order def" ;
    rdfs:comment "Each relaxed store to an atomic variable x appends to x's modification order M(x) at some position; the position may be non-obvious to the storing thread but is fixed once committed." .
kb:memory_order_relaxed_modification_order a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "memory order relaxed modification order" ;
    rdfs:comment "The per-variable constraint that each atomic variable still has a well-defined modification order agreed upon by all threads, even though relaxed operations on different variables are unconstrained relative to each other." .
kb:memory_order_relaxed_no_ordering_constraints a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "memory order relaxed no ordering constraints" ;
    rdfs:comment "The defining property that relaxed operations impose zero ordering constraints relative to any other operations on any memory location; no happens-before or synchronizes-with relationship is established with respect to other threads." .
kb:memory_order_relaxed_no_synchronization a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "memory order relaxed no synchronization" ;
    rdfs:comment "The absence of any synchronization relationship; relaxed operations do not participate in the synchronizes-with relation and do not establish happens-before edges across thread boundaries regardless of visibility." .
kb:memory_order_relaxed_program_order_within_thread a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "memory order relaxed program order within thread" ;
    rdfs:comment "The within-thread ordering guarantee that within a single thread, the program order of relaxed operations is still preserved for that thread's own perspective; only cross-thread visibility and cross-variable ordering are relaxed." .
kb:memory_order_relaxed_reordering_freedom a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "memory order relaxed reordering freedom" ;
    rdfs:comment "The freedom to reorder relaxed operations across variable boundaries; a relaxed store may be reordered with respect to a relaxed load on a different variable, and loads may observe values in an order inconsistent with program order across different locations." .
kb:memory_order_relaxed_store_buffering a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "memory order relaxed store buffering" ;
    rdfs:comment "The phenomenon that relaxed stores may be buffered in store buffers and become visible to other threads in an order different from the program order of the storing thread." .
kb:memory_order_relaxed_vs_acquire a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "memory order relaxed vs acquire" ;
    rdfs:comment "The ordering contrast where acquire_semantics prevents subsequent operations from being reordered before the acquire, while memory_order_relaxed permits all such reorderings with no barrier effect." .
kb:memory_order_relaxed_vs_release a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "memory order relaxed vs release" ;
    rdfs:comment "The ordering contrast where release_semantics prevents prior operations from being reordered after the release, while memory_order_relaxed permits all such reorderings with no barrier effect." .
kb:memory_order_relaxed_vs_seq_cst a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "memory order relaxed vs seq cst" ;
    rdfs:comment "The ordering contrast where sequentially_consistent imposes a single global total order visible to all threads, while memory_order_relaxed has no global ordering requirement across variables." .
kb:memory_order_release a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "memory order release" ;
    rdfs:comment "Memory ordering barrier ensuring all loads and stores before the barrier in program order cannot be reordered after it, making prior writes visible to acquiring threads." .
kb:memory_order_seq_cst a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "memory order seq cst" ;
    rdfs:comment "The strongest memory ordering; both a global total order of all seq_cst operations exists and the program order and synchronization order coincide, making reasoning straightforward but costly." .
kb:memory_reclamation a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "memory reclamation" ;
    rdfs:comment "Challenge of safely reclaiming freed memory in lock-free structures accessed concurrently; solutions include hazard pointers, RCU, epoch-based reclamation, and quiescent-state-based approaches." .
kb:mesi_protocol a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "mesi protocol" ;
    rdfs:comment "Four-state cache coherency protocol: Modified (exclusive, dirty), Exclusive (exclusive, clean), Shared (shared, clean), Invalid (not present); prevents inconsistent cached data." .
kb:modification_order a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "modification order" ;
    rdfs:comment "total order of writes to a single atomic variable; required for synchronizes_with to hold across threads" .
kb:modification_order_coherence a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "modification order coherence" ;
    rdfs:comment "All relaxed atomic operations on the same atomic variable still observe a single total modification order consistent across all threads, though different threads need not agree on the relative order of operations to other variables." .
kb:modification_order_per_variable_scope a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "modification order per variable scope" ;
    rdfs:comment "Each atomic variable has its own independent modification order; variable x has M(x) and variable y has M(y) with no required relationship between them." .
kb:modification_order_thread_agreement a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "modification order thread agreement" ;
    rdfs:comment "All threads agree on the modification order M(x) for each atomic variable x; this agreement is a property of the machine model not of synchronization, holding even without any happens-before edges." .
kb:modification_order_total_order a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "modification order total order" ;
    rdfs:comment "For a given atomic variable x, the modification order M(x) is a total order: all relaxed stores to x are totally ordered, forming a single agreed sequence visible to all threads." .
kb:modification_order_visibility_independence a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "modification order visibility independence" ;
    rdfs:comment "Observing a store's effect in a relaxed load does not require any visibility or synchronization relationship; the read simply selects from the modification order." .
kb:monitor a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "monitor" ;
    rdfs:comment "High-level synchronization construct combining mutex and condition variables; object-oriented abstraction where methods acquire lock automatically; ensures serialized access to object state." .
kb:mutex a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "mutex" ;
    rdfs:comment "Mutual exclusion primitive providing exclusive access to a resource; supports lock/unlock operations and optionally trylock; may be recursive or not; implements critical section semantics." .
kb:mutex_livelock_prevention a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "mutex livelock prevention" ;
    rdfs:comment "Techniques including exponential backoff, random delays, or lock registry to prevent threads from repeatedly colliding on lock acquisition." .
kb:mutex_lock a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "mutex lock" ;
    rdfs:comment "acquire operation on mutex; synchronizes_with the mutex_unlock of the thread that previously held the lock" .
kb:mutex_unlock a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "mutex unlock" ;
    rdfs:comment "release operation on mutex; synchronizes_with all subsequent mutex_lock operations on the same mutex" .
kb:no_happens_before_establishment a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "no happens before establishment" ;
    rdfs:comment "A relaxed operation neither participates in nor establishes a happens-before relationship with any other operation; operations may be reordered arbitrarily across thread boundaries." .
kb:no_partial_observation a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "no partial observation" ;
    rdfs:comment "The constraint that observers of a relaxed atomic operation cannot see byte-level or word-level fragments of the operation in flight; only complete before or after states are visible." .
kb:no_partial_value_observation a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "no partial value observation" ;
    rdfs:comment "No thread can observe a value at the target variable that represents a transient encoding representing neither the value before the operation nor the value after the operation; the observed value must be a member of the variable's modification order." .
kb:no_synchronizes_with_establishment a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "no synchronizes with establishment" ;
    rdfs:comment "A relaxed operation cannot synchronize-with any operation on another thread; release semantics and acquire semantics are absent, breaking the synchronizes-with chain." .
kb:no_tearing_guarantee a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "no tearing guarantee" ;
    rdfs:comment "The guarantee that multi-byte atomic values cannot be observed in a torn state where some bytes reflect the old value and others reflect a new concurrent value." .
kb:numa_awareness a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "numa awareness" ;
    rdfs:comment "Design consideration for systems with non-uniform memory access latency; thread affinity and data placement affect performance; synchronization must account for remote vs local memory access costs." .
kb:obstruction_free a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "obstruction free" ;
    rdfs:comment "Progress guarantee where a thread completes an operation if it runs alone without interference; may starve under contention but has no blocking operations." .
kb:out_of_order_execution a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "out of order execution" ;
    rdfs:comment "CPU feature executing instructions in data-dependency order rather than program order; enables utilization of unused execution units; interacts with memory ordering guarantees." .
kb:partial_store_order_pso a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "partial store order pso" ;
    rdfs:comment "Memory model (SPARC) where stores may be reordered with respect to older stores but loads maintain program order relative to other loads and stores respect address dependencies; relaxes TSO slightly." .
kb:per_variable_modification_order_integrity a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "per variable modification order integrity" ;
    rdfs:comment "The per-variable constraint that each atomic variable maintains a single agreed modification order even under relaxed operations; atomicity preserves this per-variable coherence order." .
kb:peterson_algorithm a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "peterson algorithm" ;
    rdfs:comment "Two-thread mutual exclusion algorithm using shared flags and a turn variable; provides bounded waiting under sequential consistency but fails on modern weak-memory hardware without memory barriers." .
kb:phased_awakening a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "phased awakening" ;
    rdfs:comment "Strategy of waking waiters in staggered groups rather than all at once; mitigates thundering herd by distributing acquisition collisions across time." .
kb:phaser_java a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "phaser java" ;
    rdfs:comment "Java 7+ flexible barrier supporting dynamic thread registration and per-phase synchronization; threads register for each phase and wait until all registered threads complete the phase." .
kb:powerpc_memory_model a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "powerpc memory model" ;
    rdfs:comment "Weak memory model used by PowerPC/POWER processors with similar permissiveness to ARM; requires explicit barriers for many ordering guarantees." .
kb:priority_inheritance a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "priority inheritance" ;
    rdfs:comment "Protocol resolving priority inversion by temporarily elevating the priority of a lock-holding low-priority thread to match the highest blocked thread." .
kb:priority_inversion a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "priority inversion" ;
    rdfs:comment "Problem where low-priority thread blocks high-priority thread by holding a lock needed by both; typically resolved via priority inheritance protocols." .
kb:producer_consumer a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "producer consumer" ;
    rdfs:comment "Concurrent pattern with producer threads generating work consumed by consumer threads; typically synchronized with bounded or unbounded channels/queues." .
kb:program_order a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "program order" ;
    rdfs:comment "The sequential ordering of operations within a single thread as written in the source code, before any concurrent interleaving is considered." .
kb:program_order_locality a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "program order locality" ;
    rdfs:comment "The property that program order defines a total order of operations only within a single thread; relaxed operations preserve this intra-thread order but nothing beyond it." .
kb:race_condition a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "race condition" ;
    rdfs:comment "Behavior where program outcome depends on relative timing of interleaved operations on shared state; general term for any timing-dependent bug in concurrent programs." .
kb:race_free a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "race free" ;
    rdfs:comment "property of an execution where all conflicting accesses are ordered by happens_before; the guarantee synchronizes_with provides" .
kb:race_free_program a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "race free program" ;
    rdfs:comment "A program in which all pairs of conflicting accesses are ordered by synchronizes-with or happens-before, guaranteeing defined semantics under the memory model." .
kb:rcu_read_copy_update a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rcu read copy update" ;
    rdfs:comment "Linux kernel synchronization mechanism allowing read-heavy workloads without reader locks; readers access data freely while writers make copies and schedule updates for later reclamation." .
kb:read_from_within_modification_order a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "read from within modification order" ;
    rdfs:comment "A relaxed load from atomic variable x returns the value stored by some store s in M(x) that precedes s in the order; the load need not observe the most recent store." .
kb:read_modify_write_indivisibility a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "read modify write indivisibility" ;
    rdfs:comment "The indivisibility of compound read-modify-write operations under relaxed ordering; fetch_add fetch_sub and similar operations complete atomically without observable intermediate states." .
kb:reader_writer_lock a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "reader writer lock" ;
    rdfs:comment "Synchronization primitive allowing multiple concurrent readers or exclusive single writer; improves read-heavy workloads but has higher overhead than simple mutex." .
kb:readers_writers_problem a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "readers writers problem" ;
    rdfs:comment "Synchronization problem requiring exclusive write access but concurrent read access; solutions vary in reader/writer preference, fairness, and implementation complexity." .
kb:reads_from a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "reads from" ;
    rdfs:comment "A relation from a read operation to a write operation whose value the read returns; a building block for happens-before reconstruction from synchronizes-with edges." .
kb:recursive_mutex a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "recursive mutex" ;
    rdfs:comment "Mutex variant permitting the same thread to acquire the lock multiple times; must be released same number of times; can hide design problems but necessary in some recursive patterns." .
kb:relaxed_atomicity a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed atomicity" ;
    rdfs:comment "The sole guarantee of memory_order_relaxed: a load or store completes atomically without torn reads or torn writes; no other constraints are imposed." .
kb:relaxed_atomicity_guarantee a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed atomicity guarantee" ;
    rdfs:comment "The sole guarantee provided by memory_order_relaxed: the atomic variable is read and written atomically without tearing, but no ordering constraints are imposed on other operations relative to the relaxed operation." .
kb:relaxed_atomicity_vs_non_atomic_torn_read a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed atomicity vs non atomic torn read" ;
    rdfs:comment "A relaxed atomic load guarantees the returned value is a member of the variable's modification order; a non-atomic load of the same memory may torn_read observe a bitwise combination of two distinct values that was never stored." .
kb:relaxed_atomicity_vs_seq_cst_atomicity a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed atomicity vs seq cst atomicity" ;
    rdfs:comment "Both relaxed and sequentially consistent atomic operations provide the same indivisibility guarantee on their target variable; the distinction lies in visibility timing and global ordering, not in the per-variable atomicity itself." .
kb:relaxed_coherence_per_location_vs_acquire_global_observation a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed coherence per location vs acquire global observation" ;
    rdfs:comment "The observation model contrast where relaxed operations on different variables maintain independent per-variable coherence orders with no cross-variable ordering coordination, while acquire semantics participates in the global sequentially consistent order when mixed with seq_cst operations." .
kb:relaxed_load a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed load" ;
    rdfs:comment "An atomic load using memory_order_relaxed reads the current value of an atomic variable with no ordering constraints: the read may be reordered before or after non-atomic operations." .
kb:relaxed_load_value_visibility_timing_vs_acquire_visibility_timing a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed load value visibility timing vs acquire visibility timing" ;
    rdfs:comment "The visibility timing contrast where a relaxed load may observe any value from the modification order at an undefined time with no guarantee about when the value becomes visible to other threads, while an acquire load observes the value at a specific point in the happens-before order with guaranteed visibility semantics." .
kb:relaxed_memory_model a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed memory model" ;
    rdfs:comment "Memory model that permits more reorderings than sequential consistency; allows loads to be reordered with respect to stores, stores to be reordered with respect to stores, etc. Examples include ARM, PowerPC, and C11's relaxed ordering." .
kb:relaxed_mod_order_def a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed mod order def" ;
    rdfs:comment "The well-defined sequential order of all store operations to a single atomic variable; every relaxed store to variable x appends to x's modification order in some position, and all threads agree on this order for x." .
kb:relaxed_mod_order_indivisibility a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed mod order indivisibility" ;
    rdfs:comment "Each modification order entry appears as an indivisible step; no intermediate store state is visible during the store, bounded by memory_order_relaxed_atomicity_guarantee." .
kb:relaxed_mod_order_load_reads_from a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed mod order load reads from" ;
    rdfs:comment "A relaxed load of atomic M reads the value written by some store in M's modification order that appears at or before the load's position; the load may observe any such prior store's value." .
kb:relaxed_mod_order_no_cross_variable_constraint a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed mod order no cross variable constraint" ;
    rdfs:comment "Modification orders of distinct atomic variables have no defined ordering relationship; operations on different variables may be observed in different orders by different threads, per memory_order_relaxed_coherence_per_location." .
kb:relaxed_mod_order_per_variable a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed mod order per variable" ;
    rdfs:comment "Each atomic variable maintains its own independent modification order; the modification order for atomic x has no defined relationship with the modification order for atomic y under relaxed semantics." .
kb:relaxed_mod_order_store_append a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed mod order store append" ;
    rdfs:comment "A relaxed store operation to atomic M atomically appends to the end of M's modification order; this append is indivisible and creates a new last element visible to all threads according to the order." .
kb:relaxed_mod_order_thread_agreement a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed mod order thread agreement" ;
    rdfs:comment "Although relaxed operations impose no ordering constraints, all threads nevertheless agree on the modification order for any given atomic variable; this agreement is a property of the machine model, not of synchronization." .
kb:relaxed_mod_order_visibility_timing_undefined a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed mod order visibility timing undefined" ;
    rdfs:comment "A store's position in the modification order does not determine when other threads observe it; relaxed loads may observe stale values with no bound on staleness, contrasting with acquire-visibility guarantees." .
kb:relaxed_model a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed model" ;
    rdfs:comment "weak memory model (ARM/Power); operations may reorder freely; synchronizes_with is the only cross-thread ordering guarantee" .
kb:relaxed_no_happens_before_edge_vs_acquire_hb_edge a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed no happens before edge vs acquire hb edge" ;
    rdfs:comment "The ordering contrast where relaxed operations never establish a happens-before edge with operations on other threads regardless of visibility timing, while acquire semantics combined with release on another thread creates a transitive happens-before edge connecting the release writer to the acquire reader." .
kb:relaxed_no_ordering_constraints_vs_acquire_subsequent_constrained a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed no ordering constraints vs acquire subsequent constrained" ;
    rdfs:comment "The scope contrast where relaxed operations impose zero ordering constraints on any other operations on any memory location, while acquire semantics constrains all subsequent loads and stores in the same thread to remain after the acquire in program order." .
kb:relaxed_no_synchronizes_with_vs_acquire_synchronizes_with a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed no synchronizes with vs acquire synchronizes with" ;
    rdfs:comment "The synchronization contrast where relaxed atomic operations do not participate in the synchronizes-with relation and establish no cross-thread ordering, while acquire operations on a matching release create a synchronizes-with relationship establishing inter-thread happens-before." .
kb:relaxed_operation_boundary a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed operation boundary" ;
    rdfs:comment "The defined point where atomicity applies for relaxed operations; each relaxed load store or read-modify-write operation is atomic at its boundary with no tearing across the boundary." .
kb:relaxed_ordering a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed ordering" ;
    rdfs:comment "memory ordering with no synchronizes_with guarantee; only atomicity and modification order of the individual variable are guaranteed" .
kb:relaxed_program_order_preservation_vs_acquire_fence_effect a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed program order preservation vs acquire fence effect" ;
    rdfs:comment "The barrier contrast where relaxed operations preserve intra-thread program order only for the storing thread's own perspective without cross-thread visibility guarantees, while acquire semantics acts as a memory fence that prevents both the compiler and processor from moving subsequent operations before the acquire point." .
kb:relaxed_read_modify_write a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed read modify write" ;
    rdfs:comment "A read-modify-write operation (fetch_add, fetch_sub, compare_exchange) using memory_order_relaxed is atomic but unordered: it reads the current value, computes, and writes atomically without establishing any ordering." .
kb:relaxed_reordering_freedom_vs_acquire_reordering_prevention a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed reordering freedom vs acquire reordering prevention" ;
    rdfs:comment "The fundamental reordering contrast where relaxed operations may be freely reordered with respect to other operations on any memory location, whereas acquire semantics forbids any subsequent operation from moving before the acquire fence." .
kb:relaxed_store a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed store" ;
    rdfs:comment "An atomic store using memory_order_relaxed writes a value to an atomic variable with no ordering constraints: the store may be reordered before or after non-atomic operations." .
kb:relaxed_store_buffering_vs_acquire_visibility_guarantee a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed store buffering vs acquire visibility guarantee" ;
    rdfs:comment "The buffering contrast where relaxed stores may remain indefinitely in store buffers and become visible to other threads in an order different from program order, while acquire semantics guarantees that all prior writes by the releasing thread become visible to the acquiring thread before the acquire completes." .
kb:relaxed_vs_acquire a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed vs acquire" ;
    rdfs:comment "A relaxed load does not acquire any synchronization semantics; subsequent operations in program order may be reordered before the relaxed load, in contrast to an acquire operation which prevents such reordering." .
kb:relaxed_vs_release a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed vs release" ;
    rdfs:comment "A relaxed store does not provide release semantics; prior operations in program order may be reordered after the relaxed store, in contrast to a release operation which prevents such reordering." .
kb:relaxed_vs_seq_cst a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "relaxed vs seq cst" ;
    rdfs:comment "Relaxed operations are not part of the single total order of sequentially consistent operations; they do not participate in the global synchronization order that sequentially consistent operations establish." .
kb:release_fence a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "release fence" ;
    rdfs:comment "A memory ordering primitive that ensures all load and store operations appearing before the fence in program order complete before any operations appearing after the fence begin." .
kb:release_op a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "release op" ;
    rdfs:comment "memory operation that makes all prior writes visible to subsequent reads via synchronizes_with; includes store with release, mutex_unlock, thread_exit, sem_signal, barrier_complete" .
kb:release_semantics a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "release semantics" ;
    rdfs:comment "Memory ordering semantics ensuring all prior loads/stores cannot be reordered after the release operation; used for lock release, writing data before a volatile flag." .
kb:reordering_freedom_privilege a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "reordering freedom privilege" ;
    rdfs:comment "A relaxed atomic operation imposes no constraints on the reordering of memory operations by either the compiler or the hardware; the operation may be reordered with any other operation including non-atomic and other atomic operations." .
kb:rlx_atomic_read a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rlx atomic read" ;
    rdfs:comment "A relaxed atomic load reads the atomic variable as one indivisible step; other threads cannot observe a torn or partial value from this read operation." .
kb:rlx_atomic_write a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rlx atomic write" ;
    rdfs:comment "A relaxed atomic store writes the atomic variable as one indivisible step; other threads cannot observe a torn or partial value from this write operation." .
kb:rlx_atomicity_core a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rlx atomicity core" ;
    rdfs:comment "The fundamental indivisibility property that any relaxed atomic operation completes as a single non-interruptible step with respect to the atomic variable; no observer can perceive partial state during the operation." .
kb:rlx_cas_atomicity a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rlx cas atomicity" ;
    rdfs:comment "The compare-and-exchange relaxed operation atomically reads the current value, compares with expected, and conditionally writes the desired value as one indivisible step if the comparison succeeds." .
kb:rlx_lli_sc_provenance a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rlx lli sc provenance" ;
    rdfs:comment "Load-linked/store-conditional primitives or bus-snooping mechanisms provide the hardware-level indivisibility guarantee underlying software-level relaxed atomicity." .
kb:rlx_no_intermediate_state a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rlx no intermediate state" ;
    rdfs:comment "The guarantee that no intermediate write value or partial read result is observable by any thread during the execution of a relaxed atomic operation; the variable transitions directly from old to new value." .
kb:rlx_per_variable_scope a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rlx per variable scope" ;
    rdfs:comment "The atomicity guarantee is scoped per individual atomic variable; relaxed atomicity on one variable does not impose or imply atomicity constraints on operations on any other variable." .
kb:rlx_rmw_indivisibility a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rlx rmw indivisibility" ;
    rdfs:comment "Read-modify-write relaxed operations such as fetch_add, fetch_sub, and compare_exchange_strong complete atomically as a single indivisible transaction on the atomic variable." .
kb:rlx_vs_ordering_distinct a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rlx vs ordering distinct" ;
    rdfs:comment "The distinction that atomicity and ordering are orthogonal properties; relaxed operations maintain atomicity but impose zero ordering constraints relative to other operations on any variable." .
kb:rmw_ind_000 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rmw ind 000" ;
    rdfs:comment "read_modify_write_indivisibility: the guarantee that compound read-modify-write operations on relaxed atomics execute as one indivisible step; no observer can perceive the intermediate read value or partial modification state between the constituent phases of the operation." .
kb:rmw_ind_001 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rmw ind 001" ;
    rdfs:comment "rmw_operation: an atomic fetch_add, fetch_sub, fetch_or, fetch_and, fetch_xor, fetch_max, fetch_min, or fetch_compare_exchange on a C11 atomic variable; the operation atomically reads the current value, computes a new value, and writes it back as a single hardware-level instruction sequence." .
kb:rmw_ind_002 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rmw ind 002" ;
    rdfs:comment "read_phase: the initial observation step of an RMW operation wherein the current value of the atomic variable is captured from the modification order; this value is returned as the operation's result for fetch variants or used as input to the modification computation." .
kb:rmw_ind_003 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rmw ind 003" ;
    rdfs:comment "modify_phase: the purely computational step wherein the value captured in the read phase is transformed by the operation's specific function (addition, subtraction, bitwise OR, bitwise AND, exclusive OR, maximum, minimum, or conditional replacement); this phase produces the value to be written but does not interact with memory." .
kb:rmw_ind_004 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rmw ind 004" ;
    rdfs:comment "write_phase: the final step wherein the result of the modify phase is written atomically to the target variable; this write becomes the new current value visible in the modification order for all subsequent operations." .
kb:rmw_ind_005 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rmw ind 005" ;
    rdfs:comment "no_intermediate_visibility: the constraint that no thread can observe the atomic variable in a state that reflects only the read_phase result or only a partial write; the variable appears unchanged until the write_phase completes, at which point it reflects the complete new value." .
kb:rmw_ind_006 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rmw ind 006" ;
    rdfs:comment "modification_order_commitment: the serialization of the RMW operation into the global modification order of the target atomic variable at the instant the write_phase becomes visible; this ordering point determines the value returned by concurrent operations." .
kb:rmw_ind_007 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rmw ind 007" ;
    rdfs:comment "relaxed_rmw_semantics: RMW operations under memory_order_relaxed still provide indivisibility guarantees even though they impose no synchronization or ordering constraints with respect to other memory accesses; the atomicity property is independent of the memory ordering property." .
kb:rmw_ind_008 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rmw ind 008" ;
    rdfs:comment "fetch_return_value: the value returned by a fetch_* operation, which is always the value observed during the read_phase before the modification was applied; this semantics distinguishes fetch_add from fetch_add_return or similar variants." .
kb:rmw_ind_009 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rmw ind 009" ;
    rdfs:comment "compare_exchange_indivisibility: the CAS operation performs an atomic compare of the observed value against an expected value and conditionally performs the write_phase only if the comparison succeeds; the compare and the conditional write constitute a single indivisible check-and-set operation." .
kb:rmw_indivisibility a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rmw indivisibility" ;
    rdfs:comment "A relaxed atomic read-modify-write operation such as fetch_add, compare_exchange, or exchange completes its read, modify, and write as one indivisible triplet on the target variable; no interleaving thread can observe a torn intermediate state." .
kb:rmw_indivisibility_subsumes_load_and_store_indivisibility a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rmw indivisibility subsumes load and store indivisibility" ;
    rdfs:comment "A read-modify-write operation's indivisibility encompasses both the load phase and the store phase as a single unified step; the read sees exactly one prior value from the modification order and the write becomes visible to subsequent operations on the same variable atomically with the read." .
kb:rwlock a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rwlock" ;
    rdfs:comment "A read-write lock primitive; writer release synchronizes-with all subsequent reader acquires and writer acquires; reader release synchronizes-with all subsequent acquires (reader or writer)." .
kb:rwlock_read_lock a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rwlock read lock" ;
    rdfs:comment "shared acquire operation; does not synchronize_with other read locks but synchronizes_with write_unlock" .
kb:rwlock_write_lock a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rwlock write lock" ;
    rdfs:comment "exclusive lock on reader-writer lock; release semantics equivalent to mutex_unlock" .
kb:rwlock_write_unlock a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rwlock write unlock" ;
    rdfs:comment "release operation on rwlock; synchronizes_with subsequent read or write lock operations" .
kb:sc_drf_guarantee a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "sc drf guarantee" ;
    rdfs:comment "The sequential-consistency-data-race-free theorem: a program with no data races is guaranteed to execute as if sequentially consistent, allowing compilers to assume SC for race-free code." .
kb:sem_signal a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "sem signal" ;
    rdfs:comment "V operation on semaphore; release semantics that may synchronize_with a sem_wait on the same semaphore" .
kb:sem_wait a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "sem wait" ;
    rdfs:comment "P operation on semaphore; acquire semantics blocking until signal is received; synchronizes_with prior sem_signal" .
kb:semaphore a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "semaphore" ;
    rdfs:comment "Synchronization primitive maintaining a counter representing available permits; P (wait/decrement) and V (signal/increment) operations; can control N concurrent accesses to a resource." .
kb:semaphore_acquire a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "semaphore acquire" ;
    rdfs:comment "A decrement of a semaphore counter that claims a permit; when it succeeds the acquire synchronizes-with the release that previously published the permit." .
kb:semaphore_gate a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "semaphore gate" ;
    rdfs:comment "A mitigation using a semaphore with initial count N to admit at most N waiters per wake event; bounds the herd size to a configured N." .
kb:semaphore_release a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "semaphore release" ;
    rdfs:comment "An increment of a semaphore counter that releases a permit; the release synchronizes-with any subsequent acquire that consumes that permit." .
kb:seq_cst a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "seq cst" ;
    rdfs:comment "sequentially consistent memory ordering providing program order, synchronization order total across all seq_cst ops, and happens-before via synchronizes_with chains" .
kb:seq_cst_atomic_visibility a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "seq cst atomic visibility" ;
    rdfs:comment "The guarantee that all threads observe the effects of a sequentially consistent operation at the same logical point in the global total order; reads observe the most recent write in the total order." .
kb:seq_cst_atomic_visibility_all_threads_agree_on_visibility_sequence a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "seq cst atomic visibility all threads agree on visibility sequence" ;
    rdfs:comment "All threads observe sequentially consistent operations in the same relative order within the global total order; no thread can see operation A before operation B if B precedes A in the seq_cst total order." .
kb:seq_cst_atomic_visibility_atomic_read_returns_written_value a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "seq cst atomic visibility atomic read returns written value" ;
    rdfs:comment "A seq_cst load returns exactly the value written by some seq_cst store to the same address in the total order; it never returns a value that was never written nor a corrupted intermediate state." .
kb:seq_cst_atomic_visibility_happens_before_cutoff_visibility a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "seq cst atomic visibility happens before cutoff visibility" ;
    rdfs:comment "A seq_cst read cannot observe a write that is ordered after it in the total order; the happens-before relationship established by seq_cst operations enforces a cutoff beyond which writes are not visible." .
kb:seq_cst_atomic_visibility_most_recent_write_in_total_order a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "seq cst atomic visibility most recent write in total order" ;
    rdfs:comment "A seq_cst load observes the value written by the most recent seq_cst store to the same address in the global total order; no later store in the order can be the source of the observed value for this load." .
kb:seq_cst_atomic_visibility_no_intermediate_state_visibility a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "seq cst atomic visibility no intermediate state visibility" ;
    rdfs:comment "During the execution of a seq_cst load or store, no intermediate memory state is visible to any thread; the operation is indivisible and appears instantaneous to all observers in the system." .
kb:seq_cst_atomic_visibility_observation_consistency_rule a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "seq cst atomic visibility observation consistency rule" ;
    rdfs:comment "If thread T1 observes thread T2's seq_cst store to address X, then T1 also observes every other seq_cst operation that precedes that store in the total order; observation is not partial or selective across the agreed sequence." .
kb:seq_cst_atomic_visibility_total_order_observation_point a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "seq cst atomic visibility total order observation point" ;
    rdfs:comment "The logical position in the seq_cst global total order at which a given sequentially consistent read operation observes the effects of preceding operations; the read's visible value is determined by all operations ordered before it in the single agreed-upon total order." .
kb:seq_cst_default_atomic_ordering a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "seq cst default atomic ordering" ;
    rdfs:comment "The default memory ordering for std::atomic operations in C11/C++11 when no memory_order is explicitly specified; provides the strongest guarantees without requiring explicit fence code." .
kb:seq_cst_default_implies_seq_cst_fence a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "seq cst default implies seq cst fence" ;
    rdfs:comment "The equivalence between an operation using the default seq_cst ordering and the same operation paired with an explicit seq_cst fence; both establish the same global ordering constraints." .
kb:seq_cst_default_semantics a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "seq cst default semantics" ;
    rdfs:comment "The implicit behavior that std::atomic operations exhibit when instantiated without an explicit memory_order template argument; this is the mandated strongest ordering level requiring no explicit fences." .
kb:seq_cst_fence a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "seq cst fence" ;
    rdfs:comment "The explicit memory fence with sequentially consistent ordering that provides both acquire and release semantics plus additional ordering constraints to enforce the global total order." .
kb:seq_cst_global_total_order a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "seq cst global total order" ;
    rdfs:comment "A single total order of all sequentially consistent operations that is visible and agreed upon by all threads in the system; the interleaving point where all threads observe the same sequence of operations." .
kb:seq_cst_happens_before_edge a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "seq cst happens before edge" ;
    rdfs:comment "A transitive ordering relation established between sequentially consistent operations that creates visibility guarantees across thread boundaries; if A happens-before B, A's effects are visible to B." .
kb:seq_cst_implies_acquire a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "seq cst implies acquire" ;
    rdfs:comment "A load operation with sequentially consistent ordering carries acquire semantics; all subsequent loads and stores cannot be reordered before the seq_cst load." .
kb:seq_cst_implies_release a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "seq cst implies release" ;
    rdfs:comment "A store operation with sequentially consistent ordering carries release semantics; all prior loads and stores cannot be reordered after the seq_cst store." .
kb:seq_cst_indivisible_atomicity a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "seq cst indivisible atomicity" ;
    rdfs:comment "The property that each sequentially consistent operation appears indivisible and instantaneous to all observers; no intermediate states are visible during the operation." .
kb:seq_cst_no_explicit_fence_required a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "seq cst no explicit fence required" ;
    rdfs:comment "The property that the sequentially consistent default provides the full barrier effect of a seq_cst fence without requiring the programmer to write one; the compiler inserts the necessary barriers automatically." .
kb:seq_cst_program_order_preservation a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "seq cst program order preservation" ;
    rdfs:comment "Within each thread, sequentially consistent operations maintain program order; no reordering of these operations is permitted within the same thread." .
kb:seq_cst_synchronization_protocol a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "seq cst synchronization protocol" ;
    rdfs:comment "The protocol by which sequentially consistent operations establish synchronization points between threads; creates a happens-before relationship across thread boundaries." .
kb:seq_cst_synchronizes_with a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "seq cst synchronizes with" ;
    rdfs:comment "A relation between release_seq_cst operations on one thread and acquire_seq_cst operations on another thread that establishes inter-thread happens-before ordering through the global total order." .
kb:sequential_consistency a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "sequential consistency" ;
    rdfs:comment "Memory model where all operations appear to execute in some total order consistent with program order on each thread; the default intuitive model where every load reads the result of the most recent store to that location in global time." .
kb:sequentially_consistent a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "sequentially consistent" ;
    rdfs:comment "The strongest memory ordering requiring a single total order of all sequentially consistent operations visible to all threads; implied by default for std::atomic operations in C++." .
kb:serializability a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "serializability" ;
    rdfs:comment "Correctness criterion for transaction systems requiring equivalent to some serial execution of transactions; differs from linearizability in handling multiple operations per transaction." .
kb:signal_delivery a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "signal delivery" ;
    rdfs:comment "The delivery of a signal to a thread creates a synchronizes-with edge from the last operation before the signal mask change to the first operation in the signal handler." .
kb:signal_handler_registration a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "signal handler registration" ;
    rdfs:comment "The registration of an asynchronous signal handler establishes a happens-before edge from the registration event to the handler's execution, ensuring visibility of operations preceding registration." .
kb:single_instruction_equivalence a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "single instruction equivalence" ;
    rdfs:comment "The relaxed atomic operation behaves as if executed as a single machine instruction with respect to the target variable; the compiler and hardware may not decompose it into separate load and store steps." .
kb:single_waker_pattern a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "single waker pattern" ;
    rdfs:comment "A mitigation structure using a single flag, permit, or ticket to ensure only one waiter proceeds per signal; e.g., a boolean guard checked atomically with wait." .
kb:software_transactional_memory_stm a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "software transactional memory stm" ;
    rdfs:comment "Transactional memory implemented entirely in software; threads validate read sets and write sets; higher overhead than HTM but works on any hardware; examples: TL2, DSTM." .
kb:speculation_prune a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "speculation prune" ;
    rdfs:comment "Runtime optimization canceling or rolling back speculative work that becomes unnecessary; hardware support for HTM speculation rollback; software speculation requires careful compensation." .
kb:speculative_execution a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "speculative execution" ;
    rdfs:comment "CPU technique executing instructions before their need is confirmed (e.g., branch prediction); rolled back on misprediction; interacts with memory ordering when speculative loads store visible data." .
kb:spinlock a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "spinlock" ;
    rdfs:comment "Lock implementation that spins in a tight loop waiting for acquisition; efficient when contention is brief but wasteful if held long; often implemented with atomic instructions." .
kb:staggered_wake_timer a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "staggered wake timer" ;
    rdfs:comment "A timer-driven phased_awakening mechanism that releases waiters in batches with fixed inter-batch delays." .
kb:starvation a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "starvation" ;
    rdfs:comment "Condition where a thread is perpetually denied resources needed for progress due to scheduling or contention patterns; unfair lock implementations may starve waiters." .
kb:store_buffer a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "store buffer" ;
    rdfs:comment "Hardware structure buffering stores before they become visible to other cores; essential for TSO performance but creates visibility delays requiring memory barriers to manage." .
kb:store_buffer_invalidation a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "store buffer invalidation" ;
    rdfs:comment "The event by which a write held in a core's store buffer is propagated to other cores' caches, completing visibility of that write to other threads." .
kb:store_buffer_linger a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "store buffer linger" ;
    rdfs:comment "A relaxed store may remain in a store buffer indefinitely before becoming visible to other threads; no fence or ordering constraint forces a flush." .
kb:store_buffering a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "store buffering" ;
    rdfs:comment "Phenomenon where a store may be buffered and become visible later, allowing a subsequent load to observe a stale value while other threads see different orderings." .
kb:store_conditional a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "store conditional" ;
    rdfs:comment "store-conditional atomic operation; release semantics only if no intervening store to the address since matching load-linked" .
kb:store_indivisibility a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "store indivisibility" ;
    rdfs:comment "A relaxed atomic store writes the complete value as one indivisible step; no intermediate write of a partial value encoded in fewer bits than the atomic word is observable by any thread." .
kb:sw_acquire_atomic_read a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "sw acquire atomic read" ;
    rdfs:comment "An atomic read operation with acquire semantics that observes the value written by a release write from another thread, establishing the synchronization point." .
kb:sw_acquire_fence a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "sw acquire fence" ;
    rdfs:comment "A memory ordering primitive that ensures all memory operations following the fence in program order observe the effects of the synchronized release operation from another thread; paired with release_fence to establish synchronization." .
kb:sw_inter_thread_happens_before a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "sw inter thread happens before" ;
    rdfs:comment "The cross-thread ordering relation established when a release operation synchronizes with an acquire operation; all effects visible to the releasing thread become visible to the acquiring thread." .
kb:sw_program_order a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "sw program order" ;
    rdfs:comment "The ordering guarantee within each individual thread: release fence orders all prior operations; acquire fence orders all subsequent operations." .
kb:sw_rel a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "sw rel" ;
    rdfs:comment "synchronizes_with relation: a release operation on an atomic object synchronizes_with an acquire operation on the same or different atomic if release and acquire are on the same atomic variable or fences establish the relation" .
kb:sw_release_atomic_write a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "sw release atomic write" ;
    rdfs:comment "An atomic write operation with release semantics that makes its value visible to other threads such that a subsequent acquire read from another thread can observe it." .
kb:sw_release_fence a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "sw release fence" ;
    rdfs:comment "A memory ordering primitive that ensures all memory operations preceding the fence in program order become visible to other threads before any operation following the fence; paired with acquire_fence to establish synchronization." .
kb:sw_seq_cst_atomic_op a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "sw seq cst atomic op" ;
    rdfs:comment "A sequentially consistent atomic operation that acts as both a release and acquire fence, providing the strongest memory ordering guarantee and synchronizing with all other seq_cst operations." .
kb:sw_thread_pair a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "sw thread pair" ;
    rdfs:comment "Two distinct threads of execution where the first performs a release operation and the second performs an acquire operation on the same atomic variable or synchronization primitive." .
kb:sw_visible_side_effect a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "sw visible side effect" ;
    rdfs:comment "The observable state change written by the releasing thread that becomes visible to the acquiring thread at the synchronization point." .
kb:sync_atomic_store_load a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "sync atomic store load" ;
    rdfs:comment "An atomic_store with release semantics on thread A synchronizes_with an atomic_load with acquire semantics on thread B, making the stored value and all preceding writes visible to the loading thread." .
kb:sync_fence_pair a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "sync fence pair" ;
    rdfs:comment "A release fence on thread A and an acquire fence on thread B that together establish the synchronizes_with relation, making all writes by A visible to B at the synchronization point." .
kb:sync_lock_release_acquire a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "sync lock release acquire" ;
    rdfs:comment "A lock_release operation on thread A synchronizes_with a lock_acquire operation on thread B, establishing ordering of all prior operations on A before subsequent operations on B." .
kb:sync_read_guarantee a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "sync read guarantee" ;
    rdfs:comment "The guarantee that a load following an acquire operation sees either the synchronized value or any write that happened-before the releasing store." .
kb:sync_seq_cst_fences a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "sync seq cst fences" ;
    rdfs:comment "Sequentially consistent fences that provide bidirectional synchronization guarantees, establishing mutual happens-before order between the synchronizing threads." .
kb:sync_visibility_boundary a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "sync visibility boundary" ;
    rdfs:comment "The precise point in execution where inter-thread visibility is guaranteed, marking the happens-before boundary between writing thread and reading thread." .
kb:sync_write_guarantee a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "sync write guarantee" ;
    rdfs:comment "The guarantee that all memory writes preceding a release operation become visible at the synchronization point to any thread performing a subsequent acquire." .
kb:synchronization_order a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "synchronization order" ;
    rdfs:comment "total order of all synchronization operations in an execution; establish ordering for synchronizes_with chains" .
kb:synchronization_variable a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "synchronization variable" ;
    rdfs:comment "An atomic object (lock, flag, barrier, channel) whose release and acquire operations create synchronizes_with edges in the memory order." .
kb:synchronizes_with a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "synchronizes with" ;
    rdfs:comment "A relation between atomic operations in memory models where a release fence on one thread synchronizes with an acquire fence on another thread, establishing happens-before order across threads." .
kb:synchronizes_with_absence a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "synchronizes with absence" ;
    rdfs:comment "A relaxed atomic operation does not synchronize with any other operation; it establishes no happens-before or synchronizes-with relationship with any thread, including the thread that performed the operation." .
kb:synchronizes_with_acquire_side a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "synchronizes with acquire side" ;
    rdfs:comment "The acquire-side endpoint of a synchronizes_with relation: an atomic operation or fence that performs an acquire action, making all subsequently observed writes visible to the acquiring thread." .
kb:synchronizes_with_chain a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "synchronizes with chain" ;
    rdfs:comment "sequence of synchronizes_with relations linking operations across threads; the backbone of inter-thread happens_before" .
kb:synchronizes_with_ordering_effect a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "synchronizes with ordering effect" ;
    rdfs:comment "The transitive visibility guarantee created when a release operation synchronizes with an acquire: all reads before the acquire see all writes after the matching release." .
kb:synchronizes_with_release_side a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "synchronizes with release side" ;
    rdfs:comment "The release-side endpoint of a synchronizes_with relation: an atomic operation or fence that performs a release action, making all prior memory operations visible to acquiring threads." .
kb:test_and_set a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "test and set" ;
    rdfs:comment "Atomic operation setting a memory location to a value (typically 1) and returning its previous contents; basis for simple spinlock implementations." .
kb:thread_creation a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "thread creation" ;
    rdfs:comment "The operation of spawning a new thread of execution; the creating thread's operations before the spawn synchronizes-with the new thread's first operation in program order." .
kb:thread_join a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "thread join" ;
    rdfs:comment "joining a thread; synchronizes_with the termination of the joined thread; acquire semantics for thread's memory effects" .
kb:thread_local_storage a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "thread local storage" ;
    rdfs:comment "Per-thread data storage allocating distinct instances to each thread; avoids synchronization for thread-private data; accessed efficiently without locking." .
kb:thread_spawn a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "thread spawn" ;
    rdfs:comment "creation of a new thread; the spawning thread synchronizes_with the start of the new thread" .
kb:thread_termination a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "thread termination" ;
    rdfs:comment "The final join or detachment of a thread; the last operation in the terminating thread synchronizes-with the join operation in the waiting thread." .
kb:thundering_herd a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "thundering herd" ;
    rdfs:comment "Pattern where many threads wake simultaneously from a blocking operation but only one can proceed; wasteful of resources; often avoided with wake-one semantics or phased awakening." .
kb:thundering_herd_backoff_adaptation a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "thundering herd backoff adaptation" ;
    rdfs:comment "A retry strategy applied by awakened waiters using backoff_iteration, base_delay, and delay_ceiling to spread acquisition attempts in time, reducing contention_surge; a per-thread mitigation complementary to wake-one and phased_awakening." .
kb:thundering_herd_contention_surge a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "thundering herd contention surge" ;
    rdfs:comment "A transient spike in the rate of lock or resource acquisition attempts triggered by mass wakeup, producing queue buildup and wasted retry cycles." .
kb:thundering_herd_fairness_starvation a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "thundering herd fairness starvation" ;
    rdfs:comment "A degraded thread fairness condition where some members of the wait_set are repeatedly overtaken by newly arriving competitors, never acquiring the resource despite eligibility." .
kb:thundering_herd_jitter_decorrelation a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "thundering herd jitter decorrelation" ;
    rdfs:comment "Application of jitter to retry delays using full_jitter, equal_jitter, or decorrelated_jitter to prevent synchronized re-attempts among awakened threads, breaking retry_coordination." .
kb:thundering_herd_phased_awakening a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "thundering herd phased awakening" ;
    rdfs:comment "A staged wakeup strategy dividing waiters into cohorts awakened in sequence rather than simultaneously, damping the contention surge through temporal distribution." .
kb:thundering_herd_retry_coordination a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "thundering herd retry coordination" ;
    rdfs:comment "The phenomenon where concurrently woken threads retry a failing operation in near-lockstep, reinforcing the contention surge; mitigated by jitter applied to retry delays." .
kb:thundering_herd_spurious_wakeup a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "thundering herd spurious wakeup" ;
    rdfs:comment "A blocking operation returning without a corresponding signal, forcing waiters to re-evaluate conditions; when mass spurious wakeups occur the thundering-herd manifests even absent real notifications." .
kb:thundering_herd_wait_queue_depth a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "thundering herd wait queue depth" ;
    rdfs:comment "The number of threads resident in the wait_set at notification time; greater depth directly scales the severity of the thundering-herd." .
kb:thundering_herd_wait_set a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "thundering herd wait set" ;
    rdfs:comment "A collection of threads blocked on a single synchronization point awaiting a condition; the structural prerequisite for thundering-herd because coordinated wakeup of this set is the failure mode." .
kb:thundering_herd_wake_one_semantics a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "thundering herd wake one semantics" ;
    rdfs:comment "A notification strategy where at most one waiter is awakened per signal, eliminating the surge by design; the canonical mitigation for thundering-herd in mutex and condition-variable implementations." .
kb:thundering_herd_wakeup_event a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "thundering herd wakeup event" ;
    rdfs:comment "A single signal or broadcast that causes ALL members of a wait_set to transition from blocked to runnable simultaneously; the atomic cause of the thundering-herd pattern." .
kb:thundering_herd_wakeup_ratio a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "thundering herd wakeup ratio" ;
    rdfs:comment "The ratio of awakened threads to threads that can usefully proceed; a ratio much greater than one indicates a thundering-herd inefficiency." .
kb:ticket_lock a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "ticket lock" ;
    rdfs:comment "Fair lock implementation using atomic ticket counter where threads take a ticket number and spin-wait until their number is called; ensures FIFO ordering and prevents starvation." .
kb:total_store_order_tso a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "total store order tso" ;
    rdfs:comment "Memory model used by x86/x64 processors where stores are globally ordered but may be buffered locally before becoming visible to other cores; a stronger model than ARM/PowerPC that prohibits most reorderings." .
kb:transactional_memory a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "transactional memory" ;
    rdfs:comment "Concurrency control paradigm allowing sequences of operations to execute atomically without explicit locking; either hardware-assisted (HTM), software-only (STM), or hybrid." .
kb:tso_model a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "tso model" ;
    rdfs:comment "total store order memory model (x86); store buffer creates write ordering anomalies but provides programmer-level synchronizes_with via locked instructions" .
kb:unlock_synchronizes_with a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "unlock synchronizes with" ;
    rdfs:comment "A specific instance of synchronizes-with: a lock-release operation synchronizes-with the lock-acquire operation of the same lock on another thread." .
kb:variable_scoped_atomicity a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "variable scoped atomicity" ;
    rdfs:comment "The atomicity guarantee applies exclusively to the specific atomic variable targeted by the relaxed operation; operations on distinct atomic variables maintain independent atomicity with no cross-variable ordering or transactionality implied." .
kb:visible_side_effect a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "visible side effect" ;
    rdfs:comment "a write W is visible to a read R if R observes the value written by W and W happens_before R" .
kb:volatile_cpp a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "volatile cpp" ;
    rdfs:comment "C++ qualifier historically used for optimization barriers; in modern C++ standard, only provides address volatility semantics, not memory ordering; use std::atomic instead." .
kb:volatile_java a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "volatile java" ;
    rdfs:comment "Java modifier ensuring visibility of writes across threads; provides acquire/release semantics on reads and writes; different from C++ volatile which lacks memory ordering guarantees." .
kb:wait_free a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "wait free" ;
    rdfs:comment "Strongest progress guarantee requiring every thread to complete any operation in finite steps regardless of other thread interference; no starvation possible." .
kb:wake_all_semantics a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "wake all semantics" ;
    rdfs:comment "Blocking primitive behavior \u2014 e.g., pthread_cond_broadcast, SetEvent, or equivalent \u2014 that resumes all waiting threads rather than selecting one; the direct cause of the wake spike." .
kb:wake_latency_spread a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "wake latency spread" ;
    rdfs:comment "Metric: the distribution of acquisition latencies among threads woken simultaneously; wide spread indicates thundering herd while tight clustering indicates controlled awakening." .
kb:wake_one_semantics a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "wake one semantics" ;
    rdfs:comment "Blocking primitive behavior that resumes exactly one selected waiter per wake event; the canonical counter-pattern to wake_all_semantics." .
kb:wake_ratio a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "wake ratio" ;
    rdfs:comment "Metric: threads woken per successful acquisition; a thundering herd has wake_ratio >> 1, ideally 1." .
kb:wake_spike a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "wake spike" ;
    rdfs:comment "The acute moment of mass simultaneous thread wake-up from a blocking primitive; the event horizon of the thundering herd." .
kb:waste_ratio a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "waste ratio" ;
    rdfs:comment "Metric: fraction of awakened threads that re-block without acquiring; directly measures the cost of a thundering herd episode." .
kb:work_bag_pattern a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "work bag pattern" ;
    rdfs:comment "A mitigation where the producer deposits work items into a lock-free queue and only one consumer wakes; avoids notifying all waiters entirely." .
kb:work_stealing a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "work stealing" ;
    rdfs:comment "Load balancing strategy where idle threads steal work from busy threads' queues; typical in fork-join frameworks like Java ForkJoinPool; reduces contention compared to work distribution." .
kb:write_buffer a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "write buffer" ;
    rdfs:comment "A per-core store buffer that holds recently performed writes before they are committed to cache; the primary source of write-read reordering and visibility delay." .
kb:write_coalescing_privilege a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "write coalescing privilege" ;
    rdfs:comment "Multiple relaxed atomic stores to the same variable by one thread may be coalesced by the implementation; the compiler may eliminate some relaxed stores entirely if it can prove the behavior is preserved." .
kb:x86_lock_prefix a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "x86 lock prefix" ;
    rdfs:comment "The x86 LOCK prefix applied to memory instructions; makes the instruction atomic and provides a full memory fence on the issuing core, establishing synchronize-with edges." .
kb:x86_mfence a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "x86 mfence" ;
    rdfs:comment "The x86 architecture's full memory fence instruction; serializes all memory reads and writes, providing full fence semantics at hardware cost." .

