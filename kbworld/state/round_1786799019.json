      "issues": [
        {
          "atom": "command_target",
          "why": "Covers destination in message metadata, but most EIP tooling (Camel, Spring Integration, WSO2 EI) routes via infrastructure (endpoints, channels) not embedded in the command. A user embedding target in the message will fight the framework.",
          "price": 10,
          "url": "https://github.com/sancovp/dark-factory-live/issues/288"
        },
        {
          "atom": "command_timeout",
          "why": "Frames timeout as a property OF the command, but in standard EIP async command-dispatch patterns, commands are fire-and-forget; the sender waits on the correlated reply, not on the command itself. Misleads users into setting timeouts on commands that won't block.",
          "price": 10,
          "url": "https://github.com/sancovp/dark-factory-live/issues/289"
        },
        {
          "atom": "event_message",
          "why": "States 'typically carrying a lightweight notification payload' but provides no threshold or guidance. Events in practice (domain events, CDC events) often carry full entity snapshots. A user will over-restrict payload size based on this wording.",
          "price": 6,
          "url": "https://github.com/sancovp/dark-factory-live/issues/290"
        },
        {
          "atom": "guaranteed_delivery",
          "why": "Definition is truncated/incomplete \u2014 ends mid-sentence. A user relying on this atom cannot understand what guaranteed delivery means without the full description.",
          "price": 9,
          "url": "https://github.com/sancovp/dark-factory-live/issues/291"
        }
      ]
    },
