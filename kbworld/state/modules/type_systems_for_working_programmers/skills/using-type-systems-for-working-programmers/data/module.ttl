kb:covariance kbo:relatesTo kb:invariance .
kb:ct_bound_variable kbo:relatesTo kb:ct_type_environment .
kb:ct_constraint kbo:relatesTo kb:constraint .
kb:ct_expression kbo:relatesTo kb:ct_type .
