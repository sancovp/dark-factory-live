@prefix kb: <https://sancovp.github.io/kb-atlas/ns/refactoring_catalog_and_code_smells#> .
@prefix kbo: <https://sancovp.github.io/kb-atlas/ns/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://sancovp.github.io/kb-atlas/ns/refactoring_catalog_and_code_smells> a owl:Ontology ;
    rdfs:label "refactoring catalog and code smells" ;
    rdfs:comment "Machine-grown, Prolog-gate-admitted knowledge module. The gate proves coherence, not truth." .

# the tiny core vocabulary (self-contained on purpose)
kbo:Concept a owl:Class .
kbo:Certificate a owl:Class .
kbo:relatesTo a owl:ObjectProperty .
kbo:binds a owl:ObjectProperty .
kbo:because a owl:ObjectProperty .
kbo:since a owl:ObjectProperty .
kbo:togetherFit a owl:ObjectProperty .
kbo:explains a owl:ObjectProperty .

kb:abstraction_gap a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "abstraction gap" ;
    rdfs:comment "The absence of domain logic, facts, or invariants that should govern the data held by the class." .
kb:accessor_method a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "accessor method" ;
    rdfs:comment "A method that returns a field value directly without transformation or business logic." .
kb:accessor_mutator_pair a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "accessor mutator pair" ;
    rdfs:comment "A matched getter and setter that expose a single data field with no intervening logic." .
kb:accessor_primitive a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "accessor primitive" ;
    rdfs:comment "An operation that reads state without modification." .
kb:agile_refactoring a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "agile refactoring" ;
    rdfs:comment "Refactoring practices aligned with agile values: continuous improvement, embracing change, sustainable pace." .
kb:anemic_domain_model a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "anemic domain model" ;
    rdfs:comment "A domain model consisting of data classes lacking the business logic that should be encapsulated within the objects themselves." .
kb:anemic_state_holder a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "anemic state holder" ;
    rdfs:comment "A data class reduced to holding state without the behavior responsible for maintaining that state's integrity." .
kb:antipattern a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "antipattern" ;
    rdfs:comment "Common response to recurring problems that is ineffective and creates new problems." .
kb:bastard_data_class a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "bastard data class" ;
    rdfs:comment "A data class that accumulates responsibility over time, violating single responsibility, often from premature aggregation of unrelated fields." .
kb:behavior_changing_refactoring a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "behavior changing refactoring" ;
    rdfs:comment "Refactoring that intentionally changes behavior, requiring corresponding test updates and verification." .
kb:behavior_preserving_refactoring a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "behavior preserving refactoring" ;
    rdfs:comment "Refactoring that maintains all observable behavior, enabling verification through existing tests." .
kb:behavior_primitive a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "behavior primitive" ;
    rdfs:comment "Meaningful logic that operates on or validates state." .
kb:bloaters a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "bloaters" ;
    rdfs:comment "Code smells indicating structures that have grown excessively large and difficult to work with." .
kb:boy_scout_rule a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "boy scout rule" ;
    rdfs:comment "Principle urging leaving code slightly cleaner than found, enabling incremental refactoring." .
kb:brain_overload a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "brain overload" ;
    rdfs:comment "Cognitive complexity where a class or method requires too much context to understand, straining working memory." .
kb:branch_by_abstraction a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "branch by abstraction" ;
    rdfs:comment "Pattern using abstraction layer to enable safe migration between implementations without big-bang rewrite." .
kb:brittle_signature a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "brittle signature" ;
    rdfs:comment "A method or function signature that requires frequent modification when new fields are added." .
kb:change_frequency_metric a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "change frequency metric" ;
    rdfs:comment "Measure of how often a field group is modified or extended together." .
kb:change_preventers a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "change preventers" ;
    rdfs:comment "Code smells requiring changes in multiple places when a single responsibility changes." .
kb:class a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "class" ;
    rdfs:comment "Primitive: a type defining fields and methods as a cohesive unit." .
kb:class_primitive a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "class primitive" ;
    rdfs:comment "A blueprint for objects, grouping state and behavior." .
kb:clump_candidate a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "clump candidate" ;
    rdfs:comment "A set of fields or parameters identified as recurring together and eligible for extraction." .
kb:coc_001 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "coc 001" ;
    rdfs:comment "commented_code_element: a syntactic unit of source code that has been rendered inactive by enclosing it in comment syntax, producing no observable execution behavior while remaining visible in the source text." .
kb:coc_002 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "coc 002" ;
    rdfs:comment "comment_syntax_container: the comment delimiters and surrounding text that physically bind the disabled code element, making its source legible but its semantics inert." .
kb:coc_003 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "coc 003" ;
    rdfs:comment "dead_execution_state: the condition of a code element whose source text exists but whose semantics are excluded from runtime interpretation." .
kb:coc_004 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "coc 004" ;
    rdfs:comment "rationale_annotation: an explanatory comment accompanying commented-out code that documents the reason for its disablement, often speculative or stale." .
kb:coc_005 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "coc 005" ;
    rdfs:comment "temporal_marker: metadata within or adjacent to commented code that indicates when it was disabled, such as a date, version number, or commit reference." .
kb:coc_006 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "coc 006" ;
    rdfs:comment "resurrection_intent: an expressed or implied intention within commented code to re-enable it in the future, typically indicated by TODO, FIXME, or similar markers." .
kb:coc_007 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "coc 007" ;
    rdfs:comment "version_control_anchor: the commit, branch, or revision at which the code element was disabled, serving as the authoritative record of its prior active state." .
kb:coc_008 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "coc 008" ;
    rdfs:comment "observer_agent: a developer or automated system that encounters commented-out code during maintenance, reading, or modification activities." .
kb:coc_009 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "coc 009" ;
    rdfs:comment "confusion_signal: the observable cognitive overhead or maintenance uncertainty experienced by an observer when encountering commented-out code without clear justification." .
kb:coc_010 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "coc 010" ;
    rdfs:comment "maintenance_burden: the increased cost of change\u2014measured in time, risk, or error likelihood\u2014imposed by commented-out code on future development activities." .
kb:coc_011 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "coc 011" ;
    rdfs:comment "code_smell: a surface indicator in source code that suggests a potential deeper problem in design or implementation, of which commented-out code is one instance." .
kb:coc_012 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "coc 012" ;
    rdfs:comment "substitution_pair: an active code element that replaces or is intended to replace a commented-out element, establishing a functional successor relationship." .
kb:code_inspection a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "code inspection" ;
    rdfs:comment "Structured examination of source code artifacts to assess quality and identify improvement opportunities." .
kb:code_quality_metric a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "code quality metric" ;
    rdfs:comment "Quantitative measure of code properties like cyclomatic complexity, coupling, cohesion, or LOC." .
kb:code_review a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "code review" ;
    rdfs:comment "Manual examination of code changes to identify smells before they enter codebase permanently." .
kb:code_rot a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "code rot" ;
    rdfs:comment "Progressive degradation of code quality and maintainability over time through accumulated small changes." .
kb:code_smell a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "code smell" ;
    rdfs:comment "A surface indication that usually corresponds to a deeper problem in system design or implementation, not a bug." .
kb:code_smell_detection a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "code smell detection" ;
    rdfs:comment "Process of identifying and classifying code smells for prioritization and remediation." .
kb:cohesion_metric a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "cohesion metric" ;
    rdfs:comment "Measure of how related elements within a module are, with low cohesion indicating missed abstractions." .
kb:collapse_hierarchy a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "collapse hierarchy" ;
    rdfs:comment "Refactoring to merge similar superclass and subclass when distinction has eroded." .
kb:commented_out_code a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "commented out code" ;
    rdfs:comment "Disabled code left in place, creating confusion and noise; should be deleted and version-controlled instead." .
kb:complexity_metric a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "complexity metric" ;
    rdfs:comment "Quantitative measure like cyclomatic complexity indicating difficulty of understanding and testing code." .
kb:composite_refactoring a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "composite refactoring" ;
    rdfs:comment "Sequence of refactorings applied together to transform a significant portion of code structure." .
kb:consolidate_duplicate_conditional_fragments a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "consolidate duplicate conditional fragments" ;
    rdfs:comment "Refactoring to move repeated code outside branches of conditional, reducing duplication." .
kb:couplers a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "couplers" ;
    rdfs:comment "Code smells indicating excessive or inappropriate dependencies between classes and modules." .
kb:coupling_metric a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "coupling metric" ;
    rdfs:comment "Measure of interdependency between modules, with high coupling indicating design weakness." .
kb:coupling_symptom a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "coupling symptom" ;
    rdfs:comment "Tight coupling arising when callers depend directly on the class's internal data structure and mutators." .
kb:cyclic_dependency a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "cyclic dependency" ;
    rdfs:comment "Mutual dependencies forming cycles between modules, preventing independent deployment and testing." .
kb:data_class a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "data class" ;
    rdfs:comment "A class containing only data fields with accessors and mutators, lacking meaningful behavior." .
kb:data_clump a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "data clump" ;
    rdfs:comment "A group of variables appearing together in multiple locations, indicating a missing class or abstraction." .
kb:data_field a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "data field" ;
    rdfs:comment "A field that stores data without associated computation or validation logic." .
kb:dc_001 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dc 001" ;
    rdfs:comment "A data_clump is a group of two or more variables that appear together as a repeated pattern across three or more distinct call sites or declarations, indicating a missing cohesive abstraction." .
kb:dc_002 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dc 002" ;
    rdfs:comment "A clump instance is a concrete occurrence where a specific set of variable names or types travel together as a bound unit across multiple locations." .
kb:dc_003 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dc 003" ;
    rdfs:comment "A clump signature is the canonical ordered set of variable names and types that define a recurring data group, used to match equivalent clumps across sites." .
kb:dc_004 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dc 004" ;
    rdfs:comment "A clump site is a distinct lexical location where the clump variables appear together, such as a function signature, method call, or field declaration." .
kb:dc_005 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dc 005" ;
    rdfs:comment "Parameter clump is a data_clump that manifests as a group of method or function parameters that repeat together across multiple call sites." .
kb:dc_006 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dc 006" ;
    rdfs:comment "State clump is a data_clump that manifests as a group of instance or class fields that are always initialized or mutated together." .
kb:dc_007 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dc 007" ;
    rdfs:comment "Contextual clump is a data_clump where the same primitive variables appear together but only within a specific subsystem or feature boundary." .
kb:dc_008 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dc 008" ;
    rdfs:comment "Missing abstraction is the root cause condition where no class, struct, or record type encapsulates a recurring variable group, forcing clients to manage the group manually." .
kb:dc_009 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dc 009" ;
    rdfs:comment "Clump threshold is the minimum repetition count (typically three or more distinct sites) required before a variable group qualifies as a detected data_clump smell." .
kb:dc_010 a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dc 010" ;
    rdfs:comment "Clump extraction is the refactoring operation that introduces a new type to represent the data group and replaces repeated variable declarations with instances of the new type." .
kb:dc_abstraction_surrogate a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dc abstraction surrogate" ;
    rdfs:comment "the new parameter or field of candidate_abstraction type that replaces the entire clump_instance at a call site." .
kb:dc_candidate_abstraction a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dc candidate abstraction" ;
    rdfs:comment "a candidate class or record type whose fields would mirror the clump_instance members, enabling replacement of the raw variables with a typed object." .
kb:dc_clump_instance a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dc clump instance" ;
    rdfs:comment "a concrete occurrence of a data_clump: a specific set of variables that repeatedly co-appear in code." .
kb:dc_cooccurrence_count a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dc cooccurrence count" ;
    rdfs:comment "an integer metric: the number of distinct call sites or scopes where the same variable set appears together." .
kb:dc_cooccurrence_threshold a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dc cooccurrence threshold" ;
    rdfs:comment "an integer metric: the minimum cooccurrence_count that qualifies a variable set as a clump_instance (commonly two or more)." .
kb:dc_root a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dc root" ;
    rdfs:comment "data_clump \u2014 a recurring group of two or more variables passed together through multiple signatures or used together across multiple scopes, indicating a missing abstraction." .
kb:dc_situation_field a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dc situation field" ;
    rdfs:comment "a clump_instance whose co-occurred variables are instance fields of one or more classes." .
kb:dc_situation_local a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dc situation local" ;
    rdfs:comment "a clump_instance whose co-occurred variables appear as locals within one or more method bodies." .
kb:dc_situation_parameter a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dc situation parameter" ;
    rdfs:comment "a clump_instance whose co-occurred variables are formal parameters of one or more method signatures." .
kb:dc_smell_anchor a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dc smell anchor" ;
    rdfs:comment "a code location where the clump_instance appears, serving as a refactoring entry point." .
kb:dc_variable_member a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dc variable member" ;
    rdfs:comment "one constituent field or parameter within a clump_instance, considered in isolation before grouping." .
kb:dead_code a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dead code" ;
    rdfs:comment "Code executed but producing no observable effect, or code that can never be executed, increasing maintenance burden." .
kb:debt_metaphor a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "debt metaphor" ;
    rdfs:comment "Metaphor framing quality shortcuts as debt accruing interest through maintenance costs until repaid." .
kb:decompose_conditional a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "decompose conditional" ;
    rdfs:comment "Refactoring to extract condition and each branch into named methods, improving conditional readability." .
kb:dependency_inversion_principle a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dependency inversion principle" ;
    rdfs:comment "Principle that high-level modules should not depend on low-level modules, violated by inappropriate intimacy." .
kb:dispensables a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dispensables" ;
    rdfs:comment "Code smells for unnecessary or vestigial elements that could be removed without losing functionality." .
kb:divergent_change a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "divergent change" ;
    rdfs:comment "A class requiring modification for multiple unrelated reasons, indicating too many responsibilities." .
kb:divergent_modularity a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "divergent modularity" ;
    rdfs:comment "Classes that evolve independently without shared abstractions, creating unnecessary duplication." .
kb:dry_principle a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dry principle" ;
    rdfs:comment "Don't Repeat Yourself principle violated by duplicated code smell, urging single source of truth." .
kb:dto a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "dto" ;
    rdfs:comment "Data Transfer Object: a legitimate data class variant whose sole purpose is to carry data across system boundaries." .
kb:duplicated_code a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "duplicated code" ;
    rdfs:comment "Identical or nearly identical code fragments appearing in multiple locations, violating DRY principle." .
kb:encapsulation_illusion a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "encapsulation illusion" ;
    rdfs:comment "Accessors and mutators expose internal state, defeating information hiding despite appearing encapsulated." .
kb:exposed_internal_state a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "exposed internal state" ;
    rdfs:comment "Data class internals exposed directly to callers without encapsulation or abstraction boundary." .
kb:extract_class a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "extract class" ;
    rdfs:comment "Refactoring to split a class with too many responsibilities into two or more cohesive classes." .
kb:extract_interface a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "extract interface" ;
    rdfs:comment "Refactoring to extract a common interface from multiple classes with shared behavior contracts." .
kb:extract_method a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "extract method" ;
    rdfs:comment "Refactoring to replace a code fragment with a method call, reducing length and improving named abstraction." .
kb:extract_variable a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "extract variable" ;
    rdfs:comment "Refactoring to assign a meaningful name to an intermediate expression, improving readability." .
kb:feature_envy a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "feature envy" ;
    rdfs:comment "A method more interested in data of other classes than its own, suggesting the method belongs elsewhere." .
kb:field a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "field" ;
    rdfs:comment "Primitive: a named member variable of a class or struct." .
kb:field_primitive a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "field primitive" ;
    rdfs:comment "A named slot holding state within a class." .
kb:form_template_method a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "form template method" ;
    rdfs:comment "Refactoring to extract varying steps of similar algorithms into template method pattern." .
kb:god_class a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "god class" ;
    rdfs:comment "An extreme case of large class with hundreds of fields and methods, absorbing too many responsibilities." .
kb:god_method a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "god method" ;
    rdfs:comment "An extreme case of long method containing thousands of lines, often containing unrelated logic." .
kb:inappropriate_intimacy a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "inappropriate intimacy" ;
    rdfs:comment "Two classes with excessive coupling, accessing each other's private details in inappropriate ways." .
kb:incremental_refactoring a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "incremental refactoring" ;
    rdfs:comment "Small-step refactoring accumulating into significant structural improvement without large risky changes." .
kb:inline_class a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "inline class" ;
    rdfs:comment "Refactoring to collapse a class whose responsibilities are trivial into its collaborating classes." .
kb:inline_method a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "inline method" ;
    rdfs:comment "Refactoring to replace a method body with its call when the method body is as clear as the name." .
kb:interface_segregation_principle a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "interface segregation principle" ;
    rdfs:comment "Principle that clients should not depend on interfaces they do not use, violated by interface pollution." .
kb:introduce_null_object a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "introduce null object" ;
    rdfs:comment "Refactoring to replace null checks with null object instances, encapsulating null handling behavior." .
kb:introduce_parameter_object a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "introduce parameter object" ;
    rdfs:comment "Refactoring to replace long parameter lists with a parameter object, grouping related data." .
kb:large_class a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "large class" ;
    rdfs:comment "A class containing too many responsibilities, fields, or lines of code indicating violation of single responsibility." .
kb:lazy_class a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "lazy class" ;
    rdfs:comment "A class that does not justify its own existence, having minimal responsibilities and low cohesion." .
kb:linter a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "linter" ;
    rdfs:comment "Static analysis tool enforcing coding conventions and detecting code smells automatically." .
kb:liskov_substitution_principle a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "liskov substitution principle" ;
    rdfs:comment "Principle that subtypes must be substitutable for base types, violated by refused bequest." .
kb:long_method a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "long method" ;
    rdfs:comment "A method that has grown too large, typically exceeding dozens of lines, making it hard to understand and maintain." .
kb:long_parameter_list a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "long parameter list" ;
    rdfs:comment "A function or method requiring excessive parameters, suggesting missing abstraction or parameter object." .
kb:lpl a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "lpl" ;
    rdfs:comment "long_parameter_list: a method or function whose parameter signature exceeds a comfortable cognitive threshold, typically citing more than three or four distinct arguments, making the interface awkward to call and maintain" .
kb:lpl_caller_clone a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "lpl caller clone" ;
    rdfs:comment "caller_signature_clone: a pattern where multiple call sites pass the same subset of parameters to a method, signaling that those parameters form a logical unit awaiting formalization as an object" .
kb:lpl_change_ripple a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "lpl change ripple" ;
    rdfs:comment "signature_change_ripple: the cascade of modifications required across all call sites when a long parameter list is altered, representing the brittleness cost of the current design" .
kb:lpl_cognitive_load a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "lpl cognitive load" ;
    rdfs:comment "parameter_cognitive_load: the mental effort required to recall the order, type, and purpose of each argument at every call site, which degrades rapidly as parameter count increases" .
kb:lpl_data_clump_rel a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "lpl data clump rel" ;
    rdfs:comment "data_clump_association: the kinship between long_parameter_list and data_clump, where the same fields appear together repeatedly across methods and constructors, both pointing toward a missing abstraction" .
kb:lpl_extract_helper a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "lpl extract helper" ;
    rdfs:comment "extract_parameter_grouping_method: splitting a long-parameter method into smaller methods that each receive a coherent subset of parameters, addressing the long method smell alongside the long parameter list" .
kb:lpl_introduce_param_obj a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "lpl introduce param obj" ;
    rdfs:comment "introduce_parameter_object_refactoring: a transformation that replaces a long parameter list with a single parameter object class, grouping related data and enabling method reuse and invariant enforcement" .
kb:lpl_invariant_leak a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "lpl invariant leak" ;
    rdfs:comment "cross_parameter_invariant: a constraint or business rule that logically spans two or more separate parameters but cannot be enforced because the parameters lack a shared container object" .
kb:lpl_long_method_rel a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "lpl long method rel" ;
    rdfs:comment "long_method_cooccurrence: the empirical pattern that methods with long parameter lists frequently also suffer from excessive length and complexity, as both stem from insufficient decomposition" .
kb:lpl_preserve_whole a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "lpl preserve whole" ;
    rdfs:comment "preserve_whole_object_refactoring: a technique that passes the source object itself rather than extracting and passing individual attributes, reducing parameter count by restoring object cohesion" .
kb:lpl_primitive_bundle a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "lpl primitive bundle" ;
    rdfs:comment "primitive_parameter_bundle: a set of primitive values that travel together through multiple method signatures, frequently indicating a missing abstraction that could be encapsulated into a coherent parameter object" .
kb:lpl_primitive_obsession_rel a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "lpl primitive obsession rel" ;
    rdfs:comment "primitive_obsession_association: the tendency to pass multiple primitives instead of a richer object, feeding the long_parameter_list problem and suggesting that introducing a parameter object also addresses primitive obsession" .
kb:lpl_replace_param_method a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "lpl replace param method" ;
    rdfs:comment "replace_parameter_with_method_call: a refactoring that eliminates a parameter by having the method obtain the value itself, applicable when the callee can compute the argument from existing parameters or object state" .
kb:lpl_test_constructor a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "lpl test constructor" ;
    rdfs:comment "test_fixture_burden: the difficulty of constructing meaningful test cases when a method requires many parameters, often leading to tests that omit or default critical arguments" .
kb:lpl_threshold a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "lpl threshold" ;
    rdfs:comment "parameter_count_threshold: the line of demarcation beyond which a parameter list is deemed excessive, commonly cited as three to four parameters in literature, though context and team conventions may shift this boundary" .
kb:martin_fowler_catalog a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "martin fowler catalog" ;
    rdfs:comment "The canonical refactoring catalog from Fowler's book, mapping smells to specific refactoring moves." .
kb:message_chain a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "message chain" ;
    rdfs:comment "A series of chained method calls like a.getB().getC().getD(), creating tight coupling across the chain." .
kb:method a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "method" ;
    rdfs:comment "Primitive: a named unit of behavior accepting parameters and operating on fields." .
kb:michael_feathers_smells a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "michael feathers smells" ;
    rdfs:comment "Smells identified by Feathers including ones that inhibit testing and safe refactoring." .
kb:middle_man a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "middle man" ;
    rdfs:comment "A class delegating almost all work to another class, indicating unnecessary indirection or missing abstraction." .
kb:missing_abstraction a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "missing abstraction" ;
    rdfs:comment "Situations where behavior is embedded in concrete data structures rather than meaningful abstractions." .
kb:missing_behavior a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "missing behavior" ;
    rdfs:comment "Behavior that logically belongs in a data class but has not been implemented, leaving it anemic." .
kb:move_method a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "move method" ;
    rdfs:comment "Refactoring to relocate a method to a class where it belongs, reducing inappropriate intimacy." .
kb:mutator_method a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "mutator method" ;
    rdfs:comment "A method that assigns a field value directly without validation or side effects." .
kb:mutator_primitive a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "mutator primitive" ;
    rdfs:comment "An operation that modifies state." .
kb:naming_pattern a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "naming pattern" ;
    rdfs:comment "Conventional suffixes or prefixes identifying data-holding classes, such as Data, DTO, VO, Bean, or Record." .
kb:oop_abusers a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "oop abusers" ;
    rdfs:comment "Code smells indicating incorrect or incomplete use of object-oriented constructs and patterns." .
kb:open_closed_principle a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "open closed principle" ;
    rdfs:comment "Principle that classes should be open for extension but closed for modification, violated by shotgun surgery." .
kb:opportunistic_refactoring a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "opportunistic refactoring" ;
    rdfs:comment "Refactoring done opportunistically when code is touched for other reasons, per Beck's rule of three." .
kb:parallel_inheritance a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "parallel inheritance" ;
    rdfs:comment "Parallel class hierarchies requiring corresponding subclasses in each, indicating coupled abstractions." .
kb:parameter a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "parameter" ;
    rdfs:comment "Primitive: an input argument to a function or method." .
kb:parameter_cluster a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "parameter cluster" ;
    rdfs:comment "A subset of method parameters passed together repeatedly across different call sites." .
kb:passive_structure a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "passive structure" ;
    rdfs:comment "A class that acts merely as a data container, hosting no meaningful behavior on its data." .
kb:planned_refactoring a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "planned refactoring" ;
    rdfs:comment "Deliberate refactoring effort scheduled and resourced separately from feature development work." .
kb:preserving_behavior a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "preserving behavior" ;
    rdfs:comment "Core invariant of refactoring: transformations must not change observable program behavior." .
kb:primitive_obsession a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "primitive obsession" ;
    rdfs:comment "Using primitive types where small objects would provide better semantics, type safety, and expressiveness." .
kb:pull_up_method a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "pull up method" ;
    rdfs:comment "Refactoring to move a method from subclass to shared superclass, reducing duplication across hierarchy." .
kb:pure_data_container a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "pure data container" ;
    rdfs:comment "The essence of a data class: state storage with no encapsulated behavior or business logic." .
kb:pure_data_structure a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "pure data structure" ;
    rdfs:comment "A struct-like data container with no methods, distinct from a data_class which still has accessor and mutator methods." .
kb:push_down_method a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "push down method" ;
    rdfs:comment "Refactoring to move a method from superclass to specific subclass, increasing specificity." .
kb:refactoring a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "refactoring" ;
    rdfs:comment "Disciplined restructuring of code to improve internal quality without altering external behavior or functionality." .
kb:refactoring_antipattern a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "refactoring antipattern" ;
    rdfs:comment "Anti-pattern where refactoring creates new problems or fails to address root causes." .
kb:refactoring_catalog a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "refactoring catalog" ;
    rdfs:comment "An organized collection of documented refactoring patterns paired with the specific code smells each addresses." .
kb:refactoring_necessity a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "refactoring necessity" ;
    rdfs:comment "Conditions indicating refactoring is warranted: slow delivery, high bug rate, difficult change requests." .
kb:refused_bequest a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "refused bequest" ;
    rdfs:comment "A subclass using only some inherited methods, suggesting inheritance hierarchy is wrong or composition preferred." .
kb:regression_test a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "regression test" ;
    rdfs:comment "Test ensuring refactored code continues to produce identical behavior, serving as safety net." .
kb:remove_dead_code a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "remove dead code" ;
    rdfs:comment "Refactoring to delete code that no longer contributes to program behavior or output." .
kb:rename_method a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "rename method" ;
    rdfs:comment "Refactoring to change an identifier to better reveal intent and improve code communication." .
kb:repeated_fields a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "repeated fields" ;
    rdfs:comment "Two or more fields appearing together across multiple method signatures or class definitions." .
kb:replace_conditional_with_polymorphism a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "replace conditional with polymorphism" ;
    rdfs:comment "Refactoring to replace type-checking conditionals with polymorphic dispatch, eliminating switch smell." .
kb:replace_delegation_with_inheritance a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "replace delegation with inheritance" ;
    rdfs:comment "Refactoring to replace delegation chain with inheritance when appropriate abstraction emerges." .
kb:replace_inheritance_with_delegation a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "replace inheritance with delegation" ;
    rdfs:comment "Refactoring to replace inheritance with delegation when a class only uses part of parent." .
kb:replace_magic_number a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "replace magic number" ;
    rdfs:comment "Refactoring to replace numeric literals with named constants, improving intent communication." .
kb:replace_nested_conditionals_with_guard_clauses a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "replace nested conditionals with guard clauses" ;
    rdfs:comment "Refactoring to use early returns for edge cases instead of deep nesting, improving clarity." .
kb:replace_primitive_with_object a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "replace primitive with object" ;
    rdfs:comment "Refactoring to replace primitive values with small objects providing richer type and behavior." .
kb:replace_temp_with_query a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "replace temp with query" ;
    rdfs:comment "Refactoring to replace temporary variables with method calls, making state implicit and localized." .
kb:replace_type_code_with_class a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "replace type code with class" ;
    rdfs:comment "Refactoring to replace numeric type codes with meaningful classes, improving type safety." .
kb:replace_type_code_with_state a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "replace type code with state" ;
    rdfs:comment "Refactoring to replace type codes with state objects when behavior varies with the type." .
kb:replace_type_code_with_subclasses a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "replace type code with subclasses" ;
    rdfs:comment "Refactoring to replace type codes with inheritance hierarchy when behavior varies per type." .
kb:self_encapsulate_field a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "self encapsulate field" ;
    rdfs:comment "Refactoring to add getter and setter methods for direct field access, enabling subclass customization." .
kb:shotgun_surgery a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "shotgun surgery" ;
    rdfs:comment "A single change requires modifying many classes, indicating responsibilities are scattered across types." .
kb:single_responsibility_principle a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "single responsibility principle" ;
    rdfs:comment "Principle that a class should have only one reason to change, violated by divergent change smell." .
kb:solid_principles a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "solid principles" ;
    rdfs:comment "Design principles (single responsibility, open-closed, Liskov substitution, interface segregation, dependency inversion) guiding refactoring targets." .
kb:speculative_generality a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "speculative generality" ;
    rdfs:comment "Classes, methods, or parameters added in anticipation of future needs that never materialized." .
kb:static_analysis a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "static analysis" ;
    rdfs:comment "Automated tool examining source code to detect patterns corresponding to known smells." .
kb:strangler_fig_pattern a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "strangler fig pattern" ;
    rdfs:comment "Incremental refactoring strategy replacing legacy system by growing new system around edges." .
kb:switch_statement_smell a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "switch statement smell" ;
    rdfs:comment "Repeated switch statements across code paths, suggesting need for polymorphism or lookup table." .
kb:technical_debt a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "technical debt" ;
    rdfs:comment "The implied cost of future rework caused by choosing expedient solutions over better approaches now." .
kb:temporal_coupling_fields a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "temporal coupling fields" ;
    rdfs:comment "Fields grouped in signatures solely by call-site timing rather than semantic cohesion." .
kb:temporary_field a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "temporary field" ;
    rdfs:comment "Fields in a class populated only under certain conditions, indicating missing abstraction or state pattern." .
kb:test_after_refactoring a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "test after refactoring" ;
    rdfs:comment "Practice of verifying refactored code produces same outputs as original, ensuring behavior preservation." .
kb:trivial_getter a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "trivial getter" ;
    rdfs:comment "A getter that merely returns an internal field with zero transformation or business meaning." .
kb:trivial_setter a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "trivial setter" ;
    rdfs:comment "A setter that merely assigns a value with no validation, side effects, or consistency enforcement." .
kb:yagni_principle a owl:NamedIndividual, kbo:Concept ;
    rdfs:label "yagni principle" ;
    rdfs:comment "You Aren't Gonna Need It principle violated by speculative generality smell." .

