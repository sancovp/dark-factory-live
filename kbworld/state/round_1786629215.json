      "issues": [
        {
          "atom": "access_token",
          "why": "Opaque is not guaranteed. JWT access tokens are explicitly NOT opaque \u2014 clients can decode and inspect them. A developer relying on this module would assume clients cannot read token contents and build broken trust boundaries.",
          "price": 6,
          "url": "https://github.com/sancovp/dark-factory-live/issues/177"
        },
        {
          "atom": "bearer_token",
          "why": "Incomplete security model. Token theft (XSS, logs, clipboard) and replay are live threats independent of TLS. A user who reads only this atom will ship bearer-token-in-JS and think they're fine because they use HTTPS.",
          "price": 7,
          "url": "https://github.com/sancovp/dark-factory-live/issues/178"
        },
        {
          "atom": "authorization_server",
          "why": "Overgeneralizes. Client credentials and device code flows have NO resource-owner authentication. A user building a machine-to-machine integration will be confused why the AS does not authenticate anyone in the conventional sense.",
          "price": 9,
          "url": "https://github.com/sancovp/dark-factory-live/issues/179"
        },
        {
          "atom": "acr_values",
          "why": "Missing caveat. The OP attempts to satisfy the requested ACR class but is not obligated to succeed. A user will file acr_values expecting guaranteed strength and get unexpected lower assurance with no error.",
          "price": 3,
          "url": "https://github.com/sancovp/dark-factory-live/issues/180"
        }
      ]
    },
