      "issues": [
        {
          "atom": "release_semantics",
          "why": "Describes release as standalone but release semantics alone provides NO cross-thread visibility \u2014 it only pairs meaningfully with acquire semantics. Omitting that counterpart caveat misleads a user into thinking release by itself synchronizes.",
          "price": 10,
          "url": "https://github.com/sancovp/dark-factory-live/issues/347"
        },
        {
          "atom": "acquire_semantics",
          "why": "Same paired-semantics omission as release_semantics: acquire alone does nothing across threads; it must synchronize-with a release operation. Framing it as a standalone guarantee is misleading.",
          "price": 21,
          "url": "https://github.com/sancovp/dark-factory-live/issues/348"
        },
        {
          "atom": "happens_before_relation",
          "why": "The definition says A's effects ARE visible to B if A hb B, which is oversimplified \u2014 happens-before does not guarantee that ALL of A's side effects are visible to B, only those that participate in the memory-ordering graph.",
          "price": 37,
          "url": "https://github.com/sancovp/dark-factory-live/issues/349"
        },
        {
          "atom": "sequentially_consistent",
          "why": "Cites C11 but every other entry in the section is labeled C++11; a user seeking the C11 spec will be confused about which standard each atom belongs to.",
          "price": 11,
          "url": "https://github.com/sancovp/dark-factory-live/issues/350"
        }
      ]
    },
