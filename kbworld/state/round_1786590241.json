      "issues": [
        {
          "atom": "happens_before_relation",
          "why": "Says effects are VISIBLE TO B - conflates ordering relation with data visibility. User might think happens-before alone guarantees B sees A's writes; requires synchronizes-with for visibility guarantees.",
          "price": 12,
          "url": "https://github.com/sancovp/dark-factory-live/issues/146"
        },
        {
          "atom": "seq_cst_atomic_visibility",
          "why": "Says reads observe the MOST RECENT write - misleading: seq_cst reads observe the most recent write IN THE GLOBAL TOTAL ORDER, not the most recent by wall-clock time. Multiple threads writing might all have newer timestamps but only one appears.",
          "price": 9,
          "url": "https://github.com/sancovp/dark-factory-live/issues/147"
        },
        {
          "atom": "mcs_lock",
          "why": "Claims O(1) bus traffic per lock ACQUISITION. MCS reduces bus traffic for waiters to O(1) by spinning locally, but the atomic operation that acquires the lock still requires cache-line transfer. The headline O(1) applies to waiters, not acquisition.",
          "price": 4,
          "url": "https://github.com/sancovp/dark-factory-live/issues/148"
        }
      ]
    },
