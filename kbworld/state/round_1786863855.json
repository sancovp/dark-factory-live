      "issues": [
        {
          "atom": "partial_state_prevention",
          "why": "Claims enforcement is achieved by deferring writes until commit. Most databases write changes immediately and control visibility via MVCC/locks. Users relying on defer-write understanding will be confused when they observe committed data visible before their own commit.",
          "price": 16,
          "url": "https://github.com/sancovp/dark-factory-live/issues/314"
        },
        {
          "atom": "c009",
          "why": "Says exclusive lock release is 'scheduled' for shared locks only. In most DBs all locks are released at commit; exclusive locks go immediately, not on a schedule. Users may expect held locks to linger longer than they do.",
          "price": 11,
          "url": "https://github.com/sancovp/dark-factory-live/issues/315"
        },
        {
          "atom": "database_transaction",
          "why": "States it guarantees ACID properties universally. Isolation level and DB engine choice determine which properties hold. READ COMMITTED and autocommit modes do not provide the same guarantees as SERIALIZABLE.",
          "price": 0,
          "url": "https://github.com/sancovp/dark-factory-live/issues/316"
        }
      ]
    },
